/* ---------------------------------------------------------------------- */
/*  HeatTree.jsx                                                           */
/*  REUSABLE: a heatmap-style treemap. Tile SIZE is proportional to each   */
/*  item's value (a real treemap, not a uniform grid) and tile COLOR is a  */
/*  continuous dark→light gradient tied to the value itself.               */
/*                                                                          */
/*  Currently used only for Deposits (Loans was removed from the dashboard  */
/*  — the API has no loans data yet) — but stays generic/reusable: nothing  */
/*  about the component itself is deposits-specific, so it's ready to      */
/*  render a Loans section again the moment that data exists.              */
/*                                                                          */
/*  TreemapTile and Legend are small pieces used only here, so they stay   */
/*  in this file instead of being split out.                              */
/* ---------------------------------------------------------------------- */

import React, { useMemo, useState } from "react";
import { Box, Stack, Typography } from "@mui/material";
import { useTheme } from "@mui/material/styles";
import Inventory2RoundedIcon from "@mui/icons-material/Inventory2Rounded";
import { GlassPanel, PanelHeader, MiniSelect, RADIUS, textSecondarySx } from "./common";
import { heatColor, mixHex, getColor, buildTreemap, formatAmount } from "./utils";

/** A single treemap cell.
 *  `absolute` (default true) controls the outer wrapper's positioning:
 *   - true  -> positions itself with left/top/width/height % (normal use,
 *              placed directly by the treemap layout).
 *   - false -> just fills 100% of its parent (used when this tile is one
 *              cell inside a UniformGroupTile's even grid, below). */
function TreemapTile({ item, x, y, w, h, color, shareLabel, onClick, absolute = true }) {
  const theme = useTheme();
  const fg = theme.palette.getContrastText(color);
  const small = w < 16 || h < 20;
  const sheen = mixHex(color, "#ffffff", 0.16);

  return (
    <Box
      sx={
        absolute
          ? { position: "absolute", left: `${x}%`, top: `${y}%`, width: `${w}%`, height: `${h}%`, p: 0.4, boxSizing: "border-box" }
          : {
              width: "100%",
              height: "100%",
              p: 0.4,
              boxSizing: "border-box",
              // FIX (overflow bug): without these, a CSS Grid cell won't
              // shrink below its content's natural (un-wrapped) width —
              // a narrow cell in a lopsided equal-value group was being
              // forced wide enough to fit its full text, spilling out
              // past the card's edge. minWidth/minHeight: 0 removes that
              // default; overflow: hidden clips anything still too big.
              minWidth: 0,
              minHeight: 0,
              overflow: "hidden",
            }
      }
    >
      <Box
        role={onClick ? "button" : undefined}
        tabIndex={onClick ? 0 : undefined}
        onClick={onClick}
        sx={{
          width: "100%",
          height: "100%",
          borderRadius: RADIUS.sm,
          p: small ? 1 : 1.75,
          display: "flex",
          flexDirection: "column",
          justifyContent: "space-between",
          overflow: "hidden",
          cursor: onClick ? "pointer" : "default",
          background: `linear-gradient(135deg, ${sheen} 0%, ${color} 55%)`,
          color: fg,
          transition: "transform 0.18s ease, box-shadow 0.18s ease",
          "&:hover": { transform: "scale(1.015)", boxShadow: theme.shadows[6], zIndex: 1 },
        }}
      >
        <Typography sx={{ fontFamily: theme.typography.fontFamily, fontSize: small ? 11 : 13, fontWeight: 600, opacity: 0.92, lineHeight: 1.25 }} noWrap>
          {item.name}
        </Typography>
        <Box sx={{ minWidth: 0 }}>
          <Typography sx={{ fontFamily: theme.typography.fontFamily, fontSize: small ? 13 : 20, fontWeight: 700, lineHeight: 1.2 }} noWrap>
            {formatAmount(item.value)}
          </Typography>
          {!small && (
            <Typography sx={{ fontFamily: theme.typography.fontFamily, fontSize: 11.5, opacity: 0.82, mt: 0.25 }}>
              {item.share}% {shareLabel}
            </Typography>
          )}
        </Box>
      </Box>
    </Box>
  );
}

/* ------------------------------------------------------------------------
 * NEW: equal-value grouping so tiles with the SAME amount look visually
 * identical, not just mathematically equal-area.
 *
 * Why this is needed: the treemap algorithm already gives two items with
 * identical values the exact same AREA — but depending on where they land
 * in the recursive split, one could end up as a tall/narrow rectangle and
 * the other as a short/wide one. Equal area, different shape — a user
 * can't tell at a glance that they're the same. Grouping same-value items
 * and rendering them as an even grid (identical width AND height per
 * cell) fixes that.
 * ---------------------------------------------------------------------- */

/** Bundles items that share the exact same `value` into a single synthetic
 * node (`{ value: combinedValue, __group: [...items] }`) so the treemap
 * sizes that whole bundle as ONE block. Items with a unique value pass
 * through unchanged. Feed the RETURNED array into buildTreemap instead of
 * the raw items list. */
function groupEqualValueItems(items) {
  const buckets = new Map(); // value -> items sharing that exact value
  items.forEach((it) => {
    const key = it.value;
    if (!buckets.has(key)) buckets.set(key, []);
    buckets.get(key).push(it);
  });

  const nodes = [];
  buckets.forEach((groupItems, value) => {
    if (groupItems.length > 1) {
      nodes.push({ value: value * groupItems.length, __group: groupItems });
    } else {
      nodes.push(groupItems[0]);
    }
  });
  return nodes;
}

/** Renders one "equal value" bundle (from groupEqualValueItems) as a
 * perfectly even grid inside the box the treemap allocated to it — every
 * cell gets the exact same width AND height (via CSS grid `1fr` tracks),
 * so equal amounts always look the same at first glance. */
function UniformGroupTile({ group, x, y, w, h, colorFor, shareLabel, onTileClick }) {
  const cols = Math.ceil(Math.sqrt(group.length));
  const rows = Math.ceil(group.length / cols);
  // Approximate per-cell % of the overall container, just so TreemapTile's
  // own "small" text-density threshold still makes a sensible choice.
  const cellW = w / cols;
  const cellH = h / rows;

  return (
    <Box
      sx={{
        position: "absolute",
        left: `${x}%`,
        top: `${y}%`,
        width: `${w}%`,
        height: `${h}%`,
        display: "grid",
        gridTemplateColumns: `repeat(${cols}, 1fr)`,
        gridTemplateRows: `repeat(${rows}, 1fr)`,
        gap: 0,
        overflow: "hidden", // defensive — the minWidth:0 fix in TreemapTile is the real fix, this just clips anything unexpected
      }}
    >
      {group.map((item) => (
        <TreemapTile
          key={item.name}
          item={item}
          w={cellW}
          h={cellH}
          color={colorFor(item.value)}
          shareLabel={shareLabel}
          onClick={onTileClick ? () => onTileClick(item) : undefined}
          absolute={false} // fill the grid cell instead of positioning itself
        />
      ))}
    </Box>
  );
}

/** Color-dot + label legend row, wraps cleanly regardless of item count. */
function Legend({ items, valueItems, colorFor }) {
  const theme = useTheme();
  return (
    <Box sx={{ mt: 2, display: "grid", gridTemplateColumns: "repeat(auto-fit, minmax(136px, 1fr))", rowGap: 0.85, columnGap: 1.5 }}>
      {items.map((l, i) => {
        const matched = valueItems && valueItems.find((it) => it.name === l.name);
        const dotColor = colorFor && matched ? colorFor(matched.value) : getColor(l.name, i, theme);
        return (
          <Stack key={l.name} direction="row" spacing={0.75} alignItems="center">
            <Box sx={{ width: 8, height: 8, borderRadius: "2px", bgcolor: dotColor, flexShrink: 0 }} />
            <Typography sx={{ ...textSecondarySx, fontSize: 11.5, fontWeight: 500 }} noWrap>
              {l.name}
            </Typography>
          </Stack>
        );
      })}
    </Box>
  );
}

/**
 * Props:
 *  - config: { title, subtitle, items: {name, value, share, type}[], legend: {name}[],
 *              filterOptions?: string[], activeFilter?: string }
 *    Each item's `type` (e.g. "Demand Deposit" / "Time Deposit") drives the
 *    filter dropdown below — `config.filterOptions` (from the API) is the
 *    dropdown's option list, and `filterOptions[0]` is treated as "show
 *    everything" (the API labels it "All Deposit"/"All ..."). Selecting any
 *    other option filters items down to `item.type === selectedOption`.
 *  - icon: MUI icon component for the panel header
 *  - gradientDark / gradientLight: hex strings, this section's gradient
 *    endpoints (e.g. navy→sky for deposits, purple→lavender for loans)
 *  - shareLabel: string appended after each tile's percentage, e.g.
 *    "of deposits" / "of loans"
 *  - onTileClick: optional (item) => void. Tiles are display-only (just a
 *    hover lift) unless this is provided.
 *  - panelId / selectedPanel / onSelectPanel: optional click-to-highlight
 *    wiring, shared with every other panel (see GlassPanel in DashboardPage.jsx).
 */
export default function HeatTree({
  config,
  icon = Inventory2RoundedIcon,
  gradientDark,
  gradientLight,
  shareLabel = "of total",
  onTileClick,
  panelId,
  selectedPanel,
  onSelectPanel,
}) {
  const hasFilter = Array.isArray(config.filterOptions) && config.filterOptions.length > 0;
  const [filter, setFilter] = useState(config.activeFilter || (hasFilter ? config.filterOptions[0] : undefined));
  const showAll = !hasFilter || filter === config.filterOptions[0];

  const items = useMemo(() => {
    if (showAll) return config.items; // first filter option = "show everything"
    return config.items.filter((it) => it.type === filter);
  }, [config.items, filter, showAll]);

  const legend = useMemo(() => {
    if (showAll) return config.legend;
    const names = new Set(items.map((it) => it.name));
    return config.legend.filter((l) => names.has(l.name));
  }, [config.legend, showAll, items]);

  const colorFor = useMemo(() => {
    const values = items.map((it) => it.value);
    const minValue = values.length ? Math.min(...values) : 0;
    const maxValue = values.length ? Math.max(...values) : 0;
    return (value) => heatColor(value, minValue, maxValue, gradientDark, gradientLight);
  }, [items, gradientDark, gradientLight]);

  // Sort largest → smallest before laying out. The treemap math already
  // gives every tile an area exactly proportional to its value regardless
  // of input order — but with real API values (some 800x bigger than
  // others), an unsorted order scattered the big/small tiles around in a
  // way that made the size differences hard to actually read as
  // "value-based" at a glance. Sorting puts the largest tile first and
  // fans everything else out from there, so size-by-amount is obvious.
  const sortedItems = useMemo(() => [...items].sort((a, b) => b.value - a.value), [items]);

  // NEW: bundle items that share the exact same value into one combined
  // node before laying out (see groupEqualValueItems above) — this is what
  // makes equal amounts render as a uniform grid instead of possibly
  // mismatched shapes.
  const treemapNodes = useMemo(() => groupEqualValueItems(sortedItems), [sortedItems]);

  const layout = useMemo(() => buildTreemap(treemapNodes, 0, 0, 100, 100, true), [treemapNodes]);

  return (
    <GlassPanel selected={selectedPanel === panelId} onClick={() => onSelectPanel?.(panelId)}>
      <PanelHeader
        icon={icon}
        title={config.title}
        action={hasFilter ? <MiniSelect options={config.filterOptions} value={filter} onChange={setFilter} /> : undefined}
      />
      {config.subtitle && (
        <Typography sx={{ ...textSecondarySx, fontSize: 12.5, mt: -1.5, mb: 1.5 }}>{config.subtitle}</Typography>
      )}

      <Box sx={{ position: "relative", width: "100%", height: { xs: 300, sm: 340, md: 380 }, overflow: "hidden" }}>
        {layout.map(({ item, x, y, w, h }) =>
          // NEW: a bundled "equal value" node (see groupEqualValueItems)
          // renders as an even grid; everything else is unchanged.
          item.__group ? (
            <UniformGroupTile
              key={item.__group.map((g) => g.name).join("|")}
              group={item.__group}
              x={x}
              y={y}
              w={w}
              h={h}
              colorFor={colorFor}
              shareLabel={shareLabel}
              onTileClick={onTileClick}
            />
          ) : (
            <TreemapTile
              key={item.name}
              item={item}
              x={x}
              y={y}
              w={w}
              h={h}
              color={colorFor(item.value)}
              shareLabel={shareLabel}
              onClick={onTileClick ? () => onTileClick(item) : undefined}
            />
          )
        )}
      </Box>

      <Legend items={legend} valueItems={items} colorFor={colorFor} />
    </GlassPanel>
  );
}
