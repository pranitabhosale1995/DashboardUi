/* ---------------------------------------------------------------------- */
/*  Composition mosaic (used for both Deposits and Loans)                  */
/*  Mirrors the reference layout: two tall tiles, a stacked pair beside    */
/*  them, and an even row of the remaining categories underneath. Every    */
/*  tile is clickable — clicking drills into that category, and only      */
/*  this panel re-renders; the rest of the dashboard is untouched.        */
/* ---------------------------------------------------------------------- */

function CompositionMosaic({ config, icon = Inventory2RoundedIcon }) {
  const theme = useTheme();
  const hasFilter = Array.isArray(config.filterOptions) && config.filterOptions.length > 0;
  const [filter, setFilter] = useState(config.activeFilter || (hasFilter ? config.filterOptions[0] : undefined));
  const [drilldown, setDrilldown] = useState(null); // { title, subtitle, data } | null
  const items = config.items;
  const [big1, big2, stackTop, stackBottom, ...rest] = items;

  const handleTileClick = (item) => {
    fetchDrilldown(item.name).then((result) => {
      if (result) setDrilldown(result);
        }}
      >
        <Typography
          sx={{
            fontFamily: theme.typography.fontFamily,
            fontSize: dense ? 11 : 12.5,
            fontWeight: 700,
            opacity: 0.95,
            lineHeight: 1.2,
          }}
        >
          {item.name}
        </Typography>
        <Box>
          <Typography sx={{ fontFamily: theme.typography.fontFamily, fontSize: dense ? 14 : 16, fontWeight: 800 }}>
            ₹ {item.value.toFixed(2)} T
          </Typography>
          <Typography sx={{ fontFamily: theme.typography.fontFamily, fontSize: dense ? 10 : 11, opacity: 0.9 }}>
            {item.share}%
          </Typography>
        </Box>
      </Box>
    );
  };

  if (drilldown) {
    return (
      <GlassPanel>
        <DrilldownBarChart icon={icon} config={drilldown} onBack={() => setDrilldown(null)} />
      </GlassPanel>
    );
          {(stackTop || stackBottom) && (
            <Box sx={{ flex: 1, display: "flex", flexDirection: "column", gap: 1 }}>
              {stackTop && <Tile item={stackTop} dense sx={{ flex: 1 }} />}
              {stackBottom && <Tile item={stackBottom} dense sx={{ flex: 1 }} />}
            </Box>
          )}
        </Box>
        {rest.length > 0 && (
          <Box sx={{ display: "flex", gap: 1, height: 78 }}>
            {rest.map((r) => (
              <Tile key={r.name} item={r} dense sx={{ flex: 1 }} />
            ))}
          </Box>
        )}
      </Box>

      <Box sx={{ mt: 2, display: "grid", gridTemplateColumns: "1fr 1fr", rowGap: 0.75, columnGap: 2 }}>
        {config.legend.map((l) => (
          <Stack key={l.name} direction="row" spacing={0.75} alignItems="center">
            <Box
              sx={{
                width: 9,
                height: 9,
                borderRadius: "3px",
                bgcolor: colorForLabel(l.name, theme),
                flexShrink: 0,
              }}
            />
            <Typography sx={{ ...textSecondarySx, fontSize: 11.5, fontWeight: 600 }} noWrap>
              {l.name}
            </Typography>
            <YAxis
              tick={{ fontSize: 11, fill: theme.palette.text.secondary }}
              axisLine={false}
              tickLine={false}
              width={32}
            />
            <Bar dataKey="value" radius={[8, 8, 0, 0]} maxBarSize={54}>
              {config.data.map((d) => (
                <Cell
                  key={d.name}
                  fill={colorForLabel(d.name, theme)}
                  cursor="pointer"
                  onClick={() => handleBarClick(d)}
                />
              ))}
              <LabelList
                dataKey="value"
                position="top"
                formatter={(v) => `₹${v < 1 ? v.toFixed(4) : v}T`}
                style={{ fontSize: 11.5, fontWeight: 800, fill: theme.palette.text.primary }}
              />
            </Bar>
          </BarChart>
        </ResponsiveContainer>
      </Box>
    </GlassPanel>
  );
}

