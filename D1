/* =========================================================
   HELPERS
========================================================= */

const formatNumber = (value) =>
  new Intl.NumberFormat("en-IN", {
    maximumFractionDigits: 1,
  }).format(value || 0);

const formatCompact = (value) => {
  if (value >= 100000) return `${(value / 100000).toFixed(1)}L`;
  if (value >= 1000) return `${(value / 1000).toFixed(1)}K`;
  return formatNumber(value);
};

/* =========================================================
   GET ALL BRANCHES
========================================================= */

function getAllBranches(yearData) {
  const result = [];

  Object.entries(yearData?.circles || {}).forEach(
    ([circleName, circleData]) => {
      Object.entries(circleData?.regions || {}).forEach(
        ([regionName, regionData]) => {
          Object.entries(regionData?.branches || {}).forEach(
            ([branchName, branchData]) => {
              result.push({
                circle: circleName,
                region: regionName,
                branch: branchName,
                ...branchData,
              });
            }
          );
        }
      );
    }
  );

  return result;
}

/* =========================================================
   TOTALS
========================================================= */

function calculateTotals(branches) {
  if (!branches.length) {
    return {
      production: 0,
      deposits: 0,
      advances: 0,
      casa: 0,
      npa: 0,
    };
  }

  const totals = branches.reduce(
    (acc, item) => {
      acc.production += Number(item.production || 0);
      acc.deposits += Number(item.deposits || 0);
      acc.advances += Number(item.advances || 0);
      acc.casa += Number(item.casa || 0);
      acc.npa += Number(item.npa || 0);

      return acc;
    },
    {
      production: 0,
      deposits: 0,
      advances: 0,
      casa: 0,
      npa: 0,
    }
  );

  totals.npa = totals.npa / branches.length;

  return totals;
}

/* =========================================================
   KPI CARD
========================================================= */

function KPICard({
  title,
  value,
  previous,
  suffix = "",
  icon,
}) {
  const growth =
    previous > 0
      ? ((value - previous) / previous) * 100
      : 0;

  return (
    <Card
      sx={{
        height: "100%",
        borderRadius: 3,
        border: "1px solid #e6e9ef",
        boxShadow: "0 4px 18px rgba(0,0,0,0.04)",
        transition: "0.2s",
        "&:hover": {
          transform: "translateY(-2px)",
          boxShadow: "0 8px 25px rgba(0,0,0,0.08)",
        },
      }}
    >
      <CardContent>
        <Box
          sx={{
            display: "flex",
            justifyContent: "space-between",
            alignItems: "center",
          }}
        >
          <Typography
            sx={{
              fontSize: 13,
              fontWeight: 600,
              color: "#667085",
            }}
          >
            {title}
          </Typography>

          <Box
            sx={{
              width: 38,
              height: 38,
              borderRadius: 2,
              display: "flex",
              alignItems: "center",
              justifyContent: "center",
              background: "#f2f4f7",
            }}
          >
            {icon}
          </Box>
        </Box>

        <Typography
          sx={{
            mt: 1,
            fontSize: 26,
            fontWeight: 800,
            color: "#101828",
          }}
        >
          {formatCompact(value)}
          {suffix}
        </Typography>

        <Typography
          sx={{
            mt: 0.5,
            fontSize: 12,
            fontWeight: 600,
            color: growth >= 0 ? "#039855" : "#d92d20",
          }}
        >
          {growth >= 0 ? "↑" : "↓"}{" "}
          {Math.abs(growth).toFixed(1)}% vs previous year
        </Typography>
      </CardContent>
    </Card>
  );
}

