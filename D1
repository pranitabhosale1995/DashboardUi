import React, { useMemo, useState } from "react";
import {
  Box,
  Card,
  CardContent,
  Typography,
  Grid,
  Stack,
  Chip,
  LinearProgress,
  FormControl,
  InputLabel,
  Select,
  MenuItem,
} from "@mui/material";

import TrendingUpRoundedIcon from "@mui/icons-material/TrendingUpRounded";
import AccountBalanceWalletRoundedIcon from "@mui/icons-material/AccountBalanceWalletRounded";
import CreditScoreRoundedIcon from "@mui/icons-material/CreditScoreRounded";
import SavingsRoundedIcon from "@mui/icons-material/SavingsRounded";
import WarningAmberRoundedIcon from "@mui/icons-material/WarningAmberRounded";

import {
  ResponsiveContainer,
  LineChart,
  Line,
  BarChart,
  Bar,
  XAxis,
  YAxis,
  CartesianGrid,
  Tooltip,
  Legend,
} from "recharts";

import dashboardData from "./dashboard.json";

const num = (value) => Number(value || 0);

const formatNumber = (value) =>
  new Intl.NumberFormat("en-IN", {
    maximumFractionDigits: 1,
  }).format(num(value));

const getGrowth = (current, previous) => {
  if (!previous) return 0;
  return ((current - previous) / previous) * 100;
};

const getBranches = (yearData) => {
  const result = [];

  Object.entries(yearData?.circles || {}).forEach(
    ([circle, circleData]) => {
      Object.entries(circleData?.regions || {}).forEach(
        ([region, regionData]) => {
          Object.entries(regionData?.branches || {}).forEach(
            ([branch, branchData]) => {
              result.push({
                circle,
                region,
                branch,
                ...branchData,
              });
            }
          );
        }
      );
    }
  );

  return result;
};

const getTotals = (branches) => {
  if (!branches.length) {
    return {
      production: 0,
      deposits: 0,
      advances: 0,
      casa: 0,
      npa: 0,
    };
  }

  return {
    production: branches.reduce(
      (sum, item) => sum + num(item.production),
      0
    ),

    deposits: branches.reduce(
      (sum, item) => sum + num(item.deposits),
      0
    ),

    advances: branches.reduce(
      (sum, item) => sum + num(item.advances),
      0
    ),

    casa: branches.reduce(
      (sum, item) => sum + num(item.casa),
      0
    ),

    npa:
      branches.reduce(
        (sum, item) => sum + num(item.npa),
        0
      ) / branches.length,
  };
};

const StatCard = ({
  title,
  value,
  previous,
  icon,
  suffix = "",
  subtitle,
}) => {
  const growth = getGrowth(value, previous);
  const positive = growth >= 0;

  return (
    <Card
      sx={{
        height: "100%",
        borderRadius: 3,
        border: "1px solid #e4e7ec",
        boxShadow: "0 3px 14px rgba(16,24,40,0.04)",
      }}
    >
      <CardContent>
        <Stack
          direction="row"
          justifyContent="space-between"
          alignItems="flex-start"
        >
          <Box>
            <Typography
              sx={{
                fontSize: 12,
                fontWeight: 700,
                color: "#667085",
              }}
            >
              {title}
            </Typography>

            <Typography
              sx={{
                mt: 0.7,
                fontSize: { xs: 22, md: 27 },
                fontWeight: 800,
                color: "#101828",
              }}
            >
              {formatNumber(value)}
              {suffix}
            </Typography>

            <Typography
              sx={{
                mt: 0.3,
                fontSize: 11,
                color: "#98A2B3",
              }}
            >
              {subtitle}
            </Typography>
          </Box>

          <Box
            sx={{
              width: 40,
              height: 40,
              borderRadius: 2,
              display: "flex",
              alignItems: "center",
              justifyContent: "center",
              background: "#f2f4f7",
            }}
          >
            {icon}
          </Box>
        </Stack>

        <Chip
          size="small"
          label={`${positive ? "↑" : "↓"} ${Math.abs(
            growth
          ).toFixed(1)}% vs previous year`}
          sx={{
            mt: 1.5,
            height: 23,
            fontSize: 10.5,
            fontWeight: 700,
            background: positive ? "#ecfdf3" : "#fef3f2",
            color: positive ? "#027a48" : "#b42318",
          }}
        />
      </CardContent>
    </Card>
  );
};

const DashboardPage = () => {
  const years = useMemo(() => {
    return Object.keys(dashboardData?.years || {}).sort(
      (a, b) => Number(b) - Number(a)
    );
  }, []);

  const [selectedYear, setSelectedYear] = useState(
    years[0] || ""
  );

  const currentYearData =
    dashboardData?.years?.[selectedYear];

  const currentIndex = years.indexOf(selectedYear);

  const previousYear = years[currentIndex + 1];

  const previousYearData =
    dashboardData?.years?.[previousYear];

  const currentBranches = useMemo(
    () => getBranches(currentYearData),
    [currentYearData]
  );

  const previousBranches = useMemo(
    () => getBranches(previousYearData),
    [previousYearData]
  );

  const currentTotals = useMemo(
    () => getTotals(currentBranches),
    [currentBranches]
  );

  const previousTotals = useMemo(
    () => getTotals(previousBranches),
    [previousBranches]
  );

  const monthlyData = useMemo(() => {
    const monthly = currentYearData?.monthlyTrend || [];

    return monthly.map((item, index) => ({
      month:
        item.month ||
        item.label ||
        `Month ${index + 1}`,
      production: num(item.production),
    }));
  }, [currentYearData]);

  const comparisonData = useMemo(() => {
    return [
      {
        name: "Deposits",
        value: currentTotals.deposits,
      },
      {
        name: "Advances",
        value: currentTotals.advances,
      },
      {
        name: "CASA",
        value: currentTotals.casa,
      },
    ];
  }, [currentTotals]);

  const target = useMemo(() => {
    const total = monthlyData.reduce(
      (sum, item) => sum + num(item.production),
      0
    );

    return total * 1.1;
  }, [monthlyData]);

  const achievement =
    target > 0
      ? Math.min(
          100,
          (currentTotals.production / target) * 100
        )
      : 0;

  return (
    <Box sx={{ p: { xs: 1.5, md: 2.5 } }}>
      <Stack
        direction={{ xs: "column", md: "row" }}
        justifyContent="space-between"
        alignItems={{ xs: "flex-start", md: "center" }}
        spacing={2}
        sx={{ mb: 2 }}
      >
        <Box>
          <Typography
            sx={{
              fontSize: 22,
              fontWeight: 800,
              color: "#101828",
            }}
          >
            Dashboard
          </Typography>

          <Typography
            sx={{
              mt: 0.4,
              fontSize: 12,
              color: "#667085",
            }}
          >
            Banking performance overview
          </Typography>
        </Box>

        <FormControl
          size="small"
          sx={{ minWidth: 160 }}
        >
          <InputLabel>Financial Year</InputLabel>

          <Select
            value={selectedYear}
            label="Financial Year"
            onChange={(event) =>
              setSelectedYear(event.target.value)
            }
          >
            {years.map((year) => (
              <MenuItem key={year} value={year}>
                {dashboardData?.years?.[year]?.label ||
                  year}
              </MenuItem>
            ))}
          </Select>
        </FormControl>
      </Stack>

      <Grid container spacing={2}>
        <Grid item xs={12} sm={6} lg={2.4}>
          <StatCard
            title="Production"
            value={currentTotals.production}
            previous={previousTotals.production}
            subtitle="Total production"
            icon={
              <TrendingUpRoundedIcon
                sx={{ color: "#175CD3" }}
              />
            }
          />
        </Grid>

        <Grid item xs={12} sm={6} lg={2.4}>
          <StatCard
            title="Deposits"
            value={currentTotals.deposits}
            previous={previousTotals.deposits}
            subtitle="Total deposits"
            icon={
              <AccountBalanceWalletRoundedIcon
                sx={{ color: "#6941C6" }}
              />
            }
          />
        </Grid>

        <Grid item xs={12} sm={6} lg={2.4}>
          <StatCard
            title="Advances"
            value={currentTotals.advances}
            previous={previousTotals.advances}
            subtitle="Total advances"
            icon={
              <CreditScoreRoundedIcon
                sx={{ color: "#027A48" }}
              />
            }
          />
        </Grid>

        <Grid item xs={12} sm={6} lg={2.4}>
          <StatCard
            title="CASA"
            value={currentTotals.casa}
            previous={previousTotals.casa}
            subtitle="CASA portfolio"
            icon={
              <SavingsRoundedIcon
                sx={{ color: "#B54708" }}
              />
            }
          />
        </Grid>

        <Grid item xs={12} sm={6} lg={2.4}>
          <StatCard
            title="Average NPA"
            value={currentTotals.npa}
            previous={previousTotals.npa}
            suffix="%"
            subtitle="Lower is better"
            icon={
              <WarningAmberRoundedIcon
                sx={{ color: "#D92D20" }}
              />
            }
          />
        </Grid>
      </Grid>

      <Card
        sx={{
          mt: 2,
          borderRadius: 3,
          border: "1px solid #e4e7ec",
          boxShadow: "0 3px 14px rgba(16,24,40,0.04)",
        }}
      >
        <CardContent>
          <Stack
            direction="row"
            justifyContent="space-between"
            alignItems="center"
          >
            <Box>
              <Typography
                sx={{
                  fontSize: 15,
                  fontWeight: 800,
                }}
              >
                Production Target Achievement
              </Typography>

              <Typography
                sx={{
                  mt: 0.3,
                  fontSize: 11,
                  color: "#667085",
                }}
              >
                Current production vs annual target
              </Typography>
            </Box>

            <Typography
              sx={{
                fontSize: 20,
                fontWeight: 800,
              }}
            >
              {achievement.toFixed(1)}%
            </Typography>
          </Stack>

          <LinearProgress
            variant="determinate"
            value={achievement}
            sx={{
              mt: 2,
              height: 9,
              borderRadius: 10,
              backgroundColor: "#eaecf0",
            }}
          />

          <Stack
            direction="row"
            justifyContent="space-between"
            sx={{ mt: 1 }}
          >
            <Typography
              sx={{
                fontSize: 11,
                color: "#667085",
              }}
            >
              Actual: {formatNumber(currentTotals.production)}
            </Typography>

            <Typography
              sx={{
                fontSize: 11,
                color: "#667085",
              }}
            >
              Target: {formatNumber(target)}
            </Typography>
          </Stack>
        </CardContent>
      </Card>


      <Grid container spacing={2} sx={{ mt: 0 }}>
        <Grid item xs={12} md={7}>
          <Card
            sx={{
              mt: 2,
              borderRadius: 3,
              border: "1px solid #e4e7ec",
              boxShadow:
                "0 3px 14px rgba(16,24,40,0.04)",
            }}
          >
            <CardContent>
              <Typography
                sx={{
                  fontSize: 15,
                  fontWeight: 800,
                }}
              >
                Monthly Production
              </Typography>

              <Typography
                sx={{
                  mt: 0.3,
                  mb: 2,
                  fontSize: 11,
                  color: "#667085",
                }}
              >
                Production trend for{" "}
                {dashboardData?.years?.[selectedYear]?.label ||
                  selectedYear}
              </Typography>

              <Box sx={{ width: "100%", height: 300 }}>
                <ResponsiveContainer>
                  <LineChart data={monthlyData}>
                    <CartesianGrid
                      strokeDasharray="3 3"
                    />

                    <XAxis dataKey="month" />

                    <YAxis
                      tickFormatter={(value) =>
                        formatNumber(value)
                      }
                    />

                    <Tooltip
                      formatter={(value) =>
                        formatNumber(value)
                      }
                    />

                    <Line
                      type="monotone"
                      dataKey="production"
                      name="Production"
                      strokeWidth={3}
                      dot={{ r: 4 }}
                    />
                  </LineChart>
                </ResponsiveContainer>
              </Box>
            </CardContent>
          </Card>
        </Grid>

        <Grid item xs={12} md={5}>
          <Card
            sx={{
              mt: 2,
              borderRadius: 3,
              border: "1px solid #e4e7ec",
              boxShadow:
                "0 3px 14px rgba(16,24,40,0.04)",
            }}
          >
            <CardContent>
              <Typography
                sx={{
                  fontSize: 15,
                  fontWeight: 800,
                }}
              >
                Portfolio Comparison
              </Typography>

              <Typography
                sx={{
                  mt: 0.3,
                  mb: 2,
                  fontSize: 11,
                  color: "#667085",
                }}
              >
                Deposits, advances and CASA
              </Typography>

              <Box sx={{ width: "100%", height: 300 }}>
                <ResponsiveContainer>
                  <BarChart data={comparisonData}>
                    <CartesianGrid
                      strokeDasharray="3 3"
                    />

                    <XAxis dataKey="name" />

                    <YAxis
                      tickFormatter={(value) =>
                        formatNumber(value)
                      }
                    />

                    <Tooltip
                      formatter={(value) =>
                        formatNumber(value)
                      }
                    />

                    <Legend />

                    <Bar
                      dataKey="value"
                      name="Amount"
                      radius={[6, 6, 0, 0]}
                    />
                  </BarChart>
                </ResponsiveContainer>
              </Box>
            </CardContent>
          </Card>
        </Grid>
      </Grid>

      <Card
        sx={{
          mt: 2,
          borderRadius: 3,
          border: "1px solid #e4e7ec",
          boxShadow:
            "0 3px 14px rgba(16,24,40,0.04)",
        }}
      >
        <CardContent>
          <Typography
            sx={{
              fontSize: 15,
              fontWeight: 800,
            }}
          >
            Key Performance Summary
          </Typography>

          <Grid container spacing={2} sx={{ mt: 0.5 }}>
            <Grid item xs={12} sm={4}>
              <Box
                sx={{
                  p: 1.5,
                  borderRadius: 2,
                  background: "#f8f9fc",
                }}
              >
                <Typography
                  sx={{
                    fontSize: 11,
                    color: "#667085",
                  }}
                >
                  Production
                </Typography>

                <Typography
                  sx={{
                    mt: 0.4,
                    fontSize: 18,
                    fontWeight: 800,
                  }}
                >
                  {formatNumber(
                    currentTotals.production
                  )}
                </Typography>
              </Box>
            </Grid>

            <Grid item xs={12} sm={4}>
              <Box
                sx={{
                  p: 1.5,
                  borderRadius: 2,
                  background: "#f8f9fc",
                }}
              >
                <Typography
                  sx={{
                    fontSize: 11,
                    color: "#667085",
                  }}
                >
                  Deposits
                </Typography>

                <Typography
                  sx={{
                    mt: 0.4,
                    fontSize: 18,
                    fontWeight: 800,
                  }}
                >
                  {formatNumber(
                    currentTotals.deposits
                  )}
                </Typography>
              </Box>
            </Grid>

            <Grid item xs={12} sm={4}>
              <Box
                sx={{
                  p: 1.5,
                  borderRadius: 2,
                  background: "#f8f9fc",
                }}
              >
                <Typography
                  sx={{
                    fontSize: 11,
                    color: "#667085",
                  }}
                >
                  Average NPA
                </Typography>

                <Typography
                  sx={{
                    mt: 0.4,
                    fontSize: 18,
                    fontWeight: 800,
                  }}
                >
                  {formatNumber(currentTotals.npa)}%
                </Typography>
              </Box>
            </Grid>
          </Grid>
        </CardContent>
      </Card>
    </Box>
  );
};

export default DashboardPage;