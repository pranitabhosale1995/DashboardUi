const formatNumber = (value) =>
  new Intl.NumberFormat("en-IN", {
    maximumFractionDigits: 1,
  }).format(Number(value || 0));

const formatPercent = (value) =>
  `${Number(value || 0).toFixed(1)}%`;

const getGrowth = (current, previous) => {
  if (!previous) return 0;
  return ((current - previous) / previous) * 100;
};

const getBranches = (yearData) => {
  const result = [];

  Object.entries(yearData?.circles || {}).forEach(
    ([circle, circleData]) => {
      Object.entries(circleData?.regions || {}).forEach(
        ([region, regionData]) => {
          Object.entries(regionData?.branches || {}).forEach(
            ([branch, branchData]) => {
              result.push({
                circle,
                region,
                branch,
                ...branchData,
              });
            }
          );
        }
      );
    }
  );

  return result;
};

const getCircleTotals = (yearData) => {
  const result = [];

  Object.entries(yearData?.circles || {}).forEach(
    ([circle, circleData]) => {
      const branches = [];

      Object.entries(circleData?.regions || {}).forEach(
        ([region, regionData]) => {
          Object.entries(regionData?.branches || {}).forEach(
            ([branch, branchData]) => {
              branches.push({
                circle,
                region,
                branch,
                ...branchData,
              });
            }
          );
        }
      );

      result.push({
        name: circle,
        production: branches.reduce(
          (sum, item) =>
            sum + Number(item.production || 0),
          0
        ),
        deposits: branches.reduce(
          (sum, item) =>
            sum + Number(item.deposits || 0),
          0
        ),
        advances: branches.reduce(
          (sum, item) =>
            sum + Number(item.advances || 0),
          0
        ),
        casa: branches.reduce(
          (sum, item) =>
            sum + Number(item.casa || 0),
          0
        ),
        npa:
          branches.length > 0
            ? branches.reduce(
                (sum, item) =>
                  sum + Number(item.npa || 0),
                0
              ) / branches.length
            : 0,
        branches,
      });
    }
  );

  return result;
};

const getRegionTotals = (circleData) => {
  const result = [];

  Object.entries(circleData?.regions || {}).forEach(
    ([region, regionData]) => {
      const branches = Object.entries(
        regionData?.branches || {}
      ).map(([branch, branchData]) => ({
        branch,
        ...branchData,
      }));

      result.push({
        name: region,
        production: branches.reduce(
          (sum, item) =>
            sum + Number(item.production || 0),
          0
        ),
        deposits: branches.reduce(
          (sum, item) =>
            sum + Number(item.deposits || 0),
          0
        ),
        advances: branches.reduce(
          (sum, item) =>
            sum + Number(item.advances || 0),
          0
        ),
        casa: branches.reduce(
          (sum, item) =>
            sum + Number(item.casa || 0),
          0
        ),
        npa:
          branches.length > 0
            ? branches.reduce(
                (sum, item) =>
                  sum + Number(item.npa || 0),
                0
              ) / branches.length
            : 0,
        branches,
      });
    }
  );

  return result;
};

const getBranchTotals = (regionData) => {
  return Object.entries(
    regionData?.branches || {}
  ).map(([branch, branchData]) => ({
    name: branch,
    ...branchData,
  }));
};

const StatCard = ({
  title,
  value,
  previous,
  icon,
  suffix = "",
  subtitle,
  inverse = false,
}) => {
  const growth = getGrowth(value, previous);

  const positive =
    inverse ? growth <= 0 : growth >= 0;

  return (
    <Card
      sx={{
        height: "100%",
        borderRadius: 3,
        border: "1px solid #E4E7EC",
        boxShadow:
          "0 3px 14px rgba(16,24,40,0.05)",
      }}
    >
      <CardContent>
        <Stack
          direction="row"
          justifyContent="space-between"
          alignItems="flex-start"
        >
          <Box>
            <Typography
              sx={{
                fontSize: 12,
                fontWeight: 700,
                color: "#667085",
              }}
            >
              {title}
            </Typography>

            <Typography
              sx={{
                mt: 0.5,
                fontSize: {
                  xs: 22,
                  md: 26,
                },
                fontWeight: 800,
                color: "#101828",
              }}
            >
              {formatNumber(value)}
              {suffix}
            </Typography>

            <Typography
              sx={{
                fontSize: 11,
                color: "#98A2B3",
                mt: 0.3,
              }}
            >
              {subtitle}
            </Typography>
          </Box>

          <Box
            sx={{
              width: 40,
              height: 40,
              borderRadius: 2,
              display: "flex",
              alignItems: "center",
              justifyContent: "center",
              background: "#F2F4F7",
            }}
          >
            {icon}
          </Box>
        </Stack>

        <Chip
          size="small"
          label={`${growth >= 0 ? "↑" : "↓"} ${Math.abs(
            growth
          ).toFixed(1)}% vs previous year`}
          sx={{
            mt: 1.5,
            height: 23,
            fontSize: 10,
            fontWeight: 700,
            background: positive
              ? "#ECFDF3"
              : "#FEF3F2",
            color: positive
              ? "#027A48"
              : "#B42318",
          }}
        />
      </CardContent>
    </Card>
  );
};

