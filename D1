    const calculate = (items) => ({
      production: items.reduce(
        (sum, item) =>
          sum + Number(item.production || 0),
        0
      ),
      deposits: items.reduce(
        (sum, item) =>
          sum + Number(item.deposits || 0),
        0
      ),
      advances: items.reduce(
        (sum, item) =>
          sum + Number(item.advances || 0),
        0
      ),
      casa: items.reduce(
        (sum, item) =>
          sum + Number(item.casa || 0),
        0
      ),
      npa:
        items.length > 0
          ? items.reduce(
              (sum, item) =>
                sum + Number(item.npa || 0),
              0
            ) / items.length
          : 0,
    });

    return {
      current: calculate(currentBranches),
      previous: calculate(previousBranches),
    };
