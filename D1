                  sm: "center",
                }}
                spacing={1}
              >
                <Box>
                  <Typography
                    fontSize={16}
                    fontWeight={800}
                  >
                    {drillTitle}
                  </Typography>

                  <Typography
                    fontSize={11}
                    color="#667085"
                  >
                    Circle → Region → Branch
                    drill-down
                  </Typography>
                </Box>

                <Stack
                  direction="row"
                  spacing={1}
                >
                  {drillLevel !==
                    "circle" && (
                    <Button
                      size="small"
                      startIcon={
                        <ArrowBackRoundedIcon />
                      }
                      onClick={handleBack}
                      variant="outlined"
                    >
                      Back
                    </Button>
                  )}

                  <FormControl
                    size="small"
                    sx={{
                      minWidth: 125,
                    }}
                  >
                    <InputLabel>
                      Metric
                    </InputLabel>

                    <Select
                      value={metric}
                      label="Metric"
                      onChange={(e) =>
                        setMetric(
                          e.target.value
                        )
                      }
                    >
                      <MenuItem value="production">
                        Production
                      </MenuItem>

                      <MenuItem value="deposits">
                        Deposits
                      </MenuItem>

                      <MenuItem value="advances">
                        Advances
                      </MenuItem>

                      <MenuItem value="casa">
                        CASA
                      </MenuItem>

                      <MenuItem value="npa">
                        NPA
                      </MenuItem>
                    </Select>
                  </FormControl>
                </Stack>
              </Stack>

              <ReactECharts
                option={drillOption}
                style={{
                  height: 360,
                  width: "100%",
                }}
                onEvents={{
                  click:
                    handleDrillClick,
                }}
                notMerge
              />
            </CardContent>
          </Card>
        </Grid>

        {/* PIE */}

        <Grid item xs={12} lg={4}>
          <Card
            sx={{
              height: "100%",
              borderRadius: 3,
              border:
                "1px solid #E4E7EC",
            }}
          >
            <CardContent>
              <Typography
                fontSize={16}
                fontWeight={800}
              >
                Distribution
              </Typography>

              <Typography
                fontSize={11}
                color="#667085"
              >
                {metric.toUpperCase()} distribution
              </Typography>

              <ReactECharts
                option={pieOption}
                style={{
                  height: 350,
                  width: "100%",
                }}
                onEvents={{
                  click:
                    handleDrillClick,
                }}
              />
            </CardContent>
          </Card>
        </Grid>
      </Grid>

      {/* BOTTOM SECTION */}

      <Grid
        container
        spacing={2}
        sx={{ mt: 0.2 }}
      >
        {/* TOP BRANCHES */}

        <Grid item xs={12} md={6}>
          <Card
            sx={{
              borderRadius: 3,
              border:
                "1px solid #E4E7EC",
            }}
          >
            <CardContent>
              <Typography
                fontSize={16}
                fontWeight={800}
              >
                Top Performing Branches
              </Typography>

              <Typography
                fontSize={11}
                color="#667085"
                mb={2}
              >
                Based on production
              </Typography>

              <Stack spacing={1.2}>
                {[...currentBranches]
                  .sort(
                    (a, b) =>
                      Number(
                        b.production || 0
                      ) -
                      Number(
                        a.production || 0
                      )
                  )
                  .slice(0, 5)
                  .map((item, index) => (
                    <Box
                      key={`${item.branch}-${index}`}
                      sx={{
                        p: 1.2,
                        borderRadius: 2,
                        background:
                          "#F8FAFC",
                      }}
                    >
                      <Stack
                        direction="row"
                        justifyContent="space-between"
                      >
                        <Box>
                          <Typography
                            fontSize={12}
                            fontWeight={700}
                          >
                            {item.branch}
                          </Typography>

                          <Typography
                            fontSize={10}
                            color="#667085"
                          >
                            {item.circle} •{" "}
                            {item.region}
                          </Typography>
                        </Box>

                        <Typography
                          fontSize={12}
                          fontWeight={800}
                        >
                          {formatNumber(
                            item.production
                          )}
                        </Typography>
                      </Stack>
                    </Box>
                  ))}
              </Stack>
            </CardContent>
          </Card>
        </Grid>

        {/* ACTIVITY */}

        <Grid item xs={12} md={6}>
          <Card
            sx={{
              height: "100%",
              borderRadius: 3,
              border:
                "1px solid #E4E7EC",
            }}
          >
            <CardContent>
              <Typography
                fontSize={16}
                fontWeight={800}
              >
                Recent Activity
              </Typography>

              <Typography
                fontSize={11}
                color="#667085"
                mb={2}
              >
                Latest dashboard updates
              </Typography>

              <Stack spacing={1.5}>
                {(
                  dashboardData?.activities ||
                  []
                )
                  .slice(0, 5)
                  .map(
                    (activity, index) => (
                      <Stack
                        key={index}
                        direction="row"
                        spacing={1.2}
                        alignItems="center"
                      >
                        <Box
                          sx={{
                            width: 9,
                            height: 9,
                            borderRadius:
                              "50%",
                            background:
                              "#175CD3",
                          }}
                        />

                        <Box>
                          <Typography
                            fontSize={12}
                            fontWeight={600}
                          >
                            {activity.title ||
                              activity.message ||
                              "Dashboard activity"}
                          </Typography>

                          <Typography
                            fontSize={10}
                            color="#98A2B3"
                          >
                            {activity.time ||
                              activity.date ||
                              ""}
                          </Typography>
                        </Box>
                      </Stack>
                    )
                  )}
              </Stack>
            </CardContent>
          </Card>
        </Grid>
      </Grid>

      {/* ANNOUNCEMENTS */}

      <Card
        sx={{
          mt: 2,
          borderRadius: 3,
          border:
            "1px solid #E4E7EC",
        }}
      >
        <CardContent>
          <Typography
            fontSize={16}
            fontWeight={800}
          >
            Announcements
          </Typography>

          <Typography
            fontSize={11}
            color="#667085"
            mb={2}
          >
            Important banking updates
          </Typography>

          <Grid
            container
            spacing={1.5}
          >
            {(
              dashboardData?.announcements ||
              []
            )
              .slice(0, 4)
              .map(
                (announcement, index) => (
                  <Grid
                    item
                    xs={12}
                    sm={6}
                    lg={3}
                    key={index}
                  >
                    <Box
                      sx={{
                        p: 1.5,
                        borderRadius: 2,
                        border:
                          "1px solid #EAECF0",
                        height: "100%",
                      }}
                    >
                      <Typography
                        fontSize={12}
                        fontWeight={700}
                      >
                        {announcement.title ||
                          "Announcement"}
                      </Typography>

                      <Typography
                        fontSize={10.5}
                        color="#667085"
                        mt={0.6}
                      >
                        {announcement.message ||
                          announcement.description ||
                          ""}
                      </Typography>

                      <Typography
                        fontSize={9.5}
                        color="#98A2B3"
                        mt={1}
                      >
                        {announcement.date ||
                          ""}
                      </Typography>
                    </Box>
                  </Grid>
                )
              )}
          </Grid>
        </CardContent>
      </Card>

      {/* FOOTER */}

      <Box
        sx={{
          mt: 2,
          pb: 2,
          textAlign: "center",
        }}
      >
        <Typography
          fontSize={10}
          color="#98A2B3"
        >
          SBI Performance Dashboard •{" "}
          {selectedYear}
        </Typography>
      </Box>
    </Box>
  );
};

export default DashboardPage;