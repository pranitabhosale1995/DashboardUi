                </Typography>

                <ReactECharts
                  option={trendOption}
                  style={{
                    width: "100%",
                    height: 390,
                  }}
                  notMerge
                  lazyUpdate
                />
              </CardContent>
            </Card>
          </Grid>

          {/* CIRCLE */}

          <Grid item xs={12} lg={4}>
            <Card
              sx={{
                borderRadius: 3,
                height: "100%",
              }}
            >
              <CardContent>
                <Typography
                  sx={{
                    fontSize: 18,
                    fontWeight: 750,
                  }}
                >
                  Circle Performance
                </Typography>

                <Typography
                  sx={{
                    color: "#667085",
                    fontSize: 12,
                  }}
                >
                  Click a circle to drill down
                </Typography>

                <ReactECharts
                  option={circleOption}
                  style={{
                    width: "100%",
                    height: 350,
                  }}
                  onEvents={{
                    click: (params) => {
                      setSelectedCircle(
                        params.name
                      );
                      setSelectedRegion("All");
                      setSelectedBranch("All");
                    },
                  }}
                />
              </CardContent>
            </Card>
          </Grid>
        </Grid>

        {/* ===================================================
            REGION + BRANCH DRILLDOWN
        =================================================== */}

        {selectedCircle !== "All" && (
          <Grid
            container
            spacing={3}
            sx={{ mb: 3 }}
          >
            {/* REGION */}

            <Grid item xs={12} lg={6}>
              <Card
                sx={{
                  borderRadius: 3,
                }}
              >
                <CardContent>
                  <Typography
                    sx={{
                      fontSize: 18,
                      fontWeight: 750,
                    }}
                  >
                    {selectedCircle} — Region
                  </Typography>

                  <Typography
                    sx={{
                      color: "#667085",
                      fontSize: 12,
                    }}
                  >
                    Click region to drill into
                    branches
                  </Typography>

                  <ReactECharts
                    option={regionOption}
                    style={{
                      height: 360,
                    }}
                    onEvents={{
                      click: (params) => {
                        setSelectedRegion(
                          params.name
                        );
                        setSelectedBranch(
                          "All"
                        );
                      },
                    }}
                  />
                </CardContent>
              </Card>
            </Grid>

            {/* BRANCH */}

            <Grid item xs={12} lg={6}>
              <Card
                sx={{
                  borderRadius: 3,
                }}
              >
                <CardContent>
                  <Typography
                    sx={{
                      fontSize: 18,
                      fontWeight: 750,
                    }}
                  >
                    {selectedRegion === "All"
                      ? `${selectedCircle} — Branches`
                      : `${selectedRegion} — Branches`}
                  </Typography>

                  <Typography
                    sx={{
                      color: "#667085",
                      fontSize: 12,
                    }}
                  >
                    Branch-wise production
                  </Typography>

                  <ReactECharts
                    option={branchOption}
                    style={{
                      height: 360,
                    }}
                    onEvents={{
                      click: (params) => {
                        setSelectedBranch(
                          params.name
                        );
                      },
                    }}
                  />
                </CardContent>
              </Card>
            </Grid>
          </Grid>
        )}

        {/* ===================================================
            TARGET VS ACHIEVEMENT
        =================================================== */}

        <Grid
          container
          spacing={3}
          sx={{ mb: 3 }}
        >
          <Grid item xs={12}>
            <Card
              sx={{
                borderRadius: 3,
              }}
            >
              <CardContent>
                <Typography
                  sx={{
                    fontSize: 18,
                    fontWeight: 750,
                  }}
                >
                  Production — Target vs
                  Achievement
                </Typography>

                <Typography
                  sx={{
                    fontSize: 12,
                    color: "#667085",
                  }}
                >
                  Monthly production performance
                </Typography>

                <ReactECharts
                  option={targetOption}
                  style={{
                    height: 370,
                    width: "100%",
                  }}
                />
              </CardContent>
            </Card>
          </Grid>
        </Grid>

        {/* ===================================================
            FOOTER STATUS
        =================================================== */}

        <Card
          sx={{
            borderRadius: 3,
            mb: 3,
          }}
        >
          <CardContent>
            <Box
              sx={{
                display: "flex",
                justifyContent:
                  "space-between",
                alignItems: "center",
                flexWrap: "wrap",
                gap: 1,
              }}
            >
              <Box>
                <Typography
                  sx={{
                    fontWeight: 700,
                  }}
                >
                  Dashboard Summary
                </Typography>

                <Typography
                  sx={{
                    fontSize: 12,
                    color: "#667085",
                    mt: 0.5,
                  }}
                >
                  Showing{" "}
                  {filteredBranches.length}{" "}
                  branches for FY{" "}
                  {selectedYear}
                </Typography>
              </Box>

              <Chip
                label="Dashboard Active"
                size="small"
              />
            </Box>
          </CardContent>
        </Card>
      </Box>
    </Box>
  );
}