                  const maxProduction =
                    topBranches[0]?.production ||
                    1;

                  const percentage =
                    (num(
                      branch.production
                    ) /
                      maxProduction) *
                    100;

                  return (
                    <Box
                      key={`${branch.branch}-${index}`}
                      sx={{
                        py: 1.3,
                        minWidth: 600,
                      }}
                    >

                      <Stack
                        direction="row"
                        alignItems="center"
                        spacing={2}
                      >

                        <Typography
                          sx={{
                            width: 25,
                            fontSize: 11,
                            fontWeight: 800,
                          }}
                        >
                          #{index + 1}
                        </Typography>

                        <Box
                          sx={{
                            width: 170,
                          }}
                        >
                          <Typography
                            sx={{
                              fontSize: 12,
                              fontWeight: 700,
                            }}
                          >
                            {branch.branch}
                          </Typography>

                          <Typography
                            sx={{
                              fontSize: 10,
                              color: "#667085",
                            }}
                          >
                            {branch.circle}
                            {" • "}
                            {branch.region}
                          </Typography>
                        </Box>

                        <Box
                          sx={{
                            flex: 1,
                          }}
                        >
                          <Box
                            sx={{
                              height: 7,
                              background:
                                "#eaecf0",
                              borderRadius: 10,
                              overflow: "hidden",
                            }}
                          >
                            <Box
                              sx={{
                                width: `${Math.min(
                                  percentage,
                                  100
                                )}%`,
                                height: "100%",
                                background:
                                  "#175CD3",
                                borderRadius: 10,
                              }}
                            />
                          </Box>
                        </Box>

                        <Typography
                          sx={{
                            width: 90,
                            textAlign: "right",
                            fontSize: 12,
                            fontWeight: 800,
                          }}
                        >
                          {formatCompact(
                            branch.production
                          )}
                        </Typography>

                      </Stack>

                    </Box>
                  );
                }
              )}

            </Box>

          </CardContent>

        </Card>

      </Box>


      {/* =================================================
          FOOTER
      ================================================= */}

      <Box
        sx={{
          mt: 2,
          pb: 1,
          textAlign: "center",
        }}
      >
        <Typography
          sx={{
            fontSize: 10,
            color: "#98A2B3",
          }}
        >
          SBI Performance Dashboard •
          {selectedYear}
        </Typography>
      </Box>

    </Box>
  );
};


export default DashboardPage;