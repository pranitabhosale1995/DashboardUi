import React, { useMemo, useState } from "react";
import {
  ResponsiveContainer,
  LineChart,
  Line,
  XAxis,
  YAxis,
  CartesianGrid,
  Tooltip,
  Legend,
  BarChart,
  Bar,
  PieChart,
  Pie,
  Cell,
  Treemap
} from "recharts";

import {
  Box,
  Card,
  CardContent,
  Typography,
  ToggleButton,
  ToggleButtonGroup,
  Button,
  Chip
} from "@mui/material";

import {
  Refresh,
  TrendingUp,
  AccountBalance,
  Savings,
  CreditCard,
  PieChart as PieIcon
} from "@mui/icons-material";

import data from "./bankingData.json";

const fmt = n => {
  if (Math.abs(n) >= 1e12) {
    return `₹${(n / 1e12).toFixed(2)}T`;
  }

  if (Math.abs(n) >= 1e9) {
    return `₹${(n / 1e9).toFixed(2)}B`;
  }

  if (Math.abs(n) >= 1e6) {
    return `₹${(n / 1e6).toFixed(2)}M`;
  }

  return `₹${Number(n).toLocaleString("en-IN")}`;
};

const pct = n => `${(n * 100).toFixed(2)}%`;

const colors = [
  "#315B9A",
  "#4E78B7",
  "#6D91C4",
  "#8CA9D0",
  "#A9BBD8"
];

function Panel({ title, subtitle, children, className = "" }) {
  return (
    <Card
      className={className}
      sx={{
        height: "100%",
        borderRadius: 3,
        boxShadow: "0 2px 12px rgba(0,0,0,0.06)"
      }}
    >
      <CardContent sx={{ height: "100%", p: 2 }}>
        <Typography
          fontWeight={700}
          fontSize={15}
          color="#17233c"
        >
          {title}
        </Typography>

        {subtitle && (
          <Typography
            color="text.secondary"
            fontSize={11}
            mb={1.5}
          >
            {subtitle}
          </Typography>
        )}

        <Box sx={{ height: "calc(100% - 45px)" }}>
          {children}
        </Box>
      </CardContent>
    </Card>
  );
}

function KPI({ title, value, sub, icon }) {
  return (
    <Card
      sx={{
        borderRadius: 3,
        height: "100%",
        boxShadow: "0 2px 12px rgba(0,0,0,0.06)"
      }}
    >
      <CardContent sx={{ p: 2 }}>
        <Box
          display="flex"
          justifyContent="space-between"
          alignItems="center"
        >
          <Typography
            color="text.secondary"
            fontSize={12}
          >
            {title}
          </Typography>

          <Box sx={{ color: "#315B9A" }}>
            {icon}
          </Box>
        </Box>

        <Typography
          fontSize={{ xs: 22, md: 28 }}
          fontWeight={700}
          color="#315B9A"
          mt={1}
        >
          {value}
        </Typography>

        <Typography
          fontSize={11}
          color="text.secondary"
          mt={0.5}
        >
          {sub}
        </Typography>
      </CardContent>
    </Card>
  );
}

function NestedChart({ data: chartData }) {
  return (
    <ResponsiveContainer
      width="100%"
      height="100%"
    >
      <Treemap
        data={chartData.children}
        dataKey="value"
        nameKey="name"
        stroke="#fff"
        aspectRatio={4 / 3}
      >
        <Tooltip formatter={v => fmt(v)} />
      </Treemap>
    </ResponsiveContainer>
  );
}

function Donut({ value }) {
  const chart = [
    {
      name: "CASA",
      value: value * 100
    },
    {
      name: "Term",
      value: 100 - value * 100
    }
  ];

  return (
    <ResponsiveContainer
      width="100%"
      height="100%"
    >
      <PieChart>
        <Pie
          data={chart}
          innerRadius="62%"
          outerRadius="82%"
          dataKey="value"
          startAngle={90}
          endAngle={-270}
          paddingAngle={2}
        >
          {chart.map((_, i) => (
            <Cell
              key={i}
              fill={colors[i]}
            />
          ))}
        </Pie>

        <text
          x="50%"
          y="48%"
          textAnchor="middle"
          dominantBaseline="middle"
          fontSize="22"
          fontWeight="700"
          fill="#315B9A"
        >
          {pct(value)}
        </text>

        <text
          x="50%"
          y="61%"
          textAnchor="middle"
          fontSize="11"
          fill="#777"
        >
          CASA Ratio
        </text>

        <Tooltip
          formatter={v =>
            `${v.toFixed(2)}%`
          }
        />
      </PieChart>
    </ResponsiveContainer>
  );
}

export default function Dashboard() {
  const [type, setType] = useState("deposit");

  const [selectedDate, setSelectedDate] =
    useState(4);

  const [showMore, setShowMore] =
    useState(false);

  const current = data[type];

  const trendData = useMemo(
    () =>
      current.dates.map((date, i) => ({
        date,

        value:
          type === "deposit"
            ? current.totalDepositTrend[i]
            : current.loanTrend[i]
      })),
    [current, type]
  );

  const selectedValue =
    type === "deposit"
      ? current.totalDepositTrend[selectedDate]
      : current.loanTrend[selectedDate];

  const handleType = (_, value) => {
    if (value) {
      setType(value);
      setSelectedDate(4);
      setShowMore(false);
    }
  };

  return (
    <Box
      sx={{
        minHeight: "100vh",
        background: "#f5f7fb",
        p: {
          xs: 1.5,
          md: 3
        }
      }}
    >
      {/* HEADER */}

      <Box
        display="flex"
        justifyContent="space-between"
        alignItems={{
          xs: "flex-start",
          md: "center"
        }}
        flexDirection={{
          xs: "column",
          md: "row"
        }}
        gap={2}
        mb={2}
      >
        <Box>
          <Typography
            fontSize={{
              xs: 24,
              md: 30
            }}
            fontWeight={800}
            color="#17233c"
          >
            {type === "deposit"
              ? "DEPOSITS"
              : "LOANS"}{" "}

            <Box
              component="span"
              fontWeight={400}
            >
              DASHBOARD
            </Box>
          </Typography>

          <Typography
            fontSize={12}
            color="text.secondary"
          >
            Evaluating banking financial performance
          </Typography>
        </Box>

        <Box
          display="flex"
          gap={1}
          alignItems="center"
          flexWrap="wrap"
        >
          <Chip
            label={data.financialYear}
            variant="outlined"
            sx={{
              fontWeight: 600
            }}
          />

          <ToggleButtonGroup
            value={type}
            exclusive
            onChange={handleType}
            size="small"
          >
            <ToggleButton value="deposit">
              Deposit
            </ToggleButton>

            <ToggleButton value="loan">
              Loan
            </ToggleButton>
          </ToggleButtonGroup>

          <Button
            variant="outlined"
            size="small"
            onClick={() =>
              setSelectedDate(4)
            }
            startIcon={<Refresh />}
          >
            Reset
          </Button>
        </Box>
      </Box>

      {/* KPI ROW */}

      <Box
        display="grid"
        gridTemplateColumns={{
          xs: "1fr",
          sm: "repeat(2, 1fr)",
          lg: "repeat(4, 1fr)"
        }}
        gap={1.5}
        mb={1.5}
      >
        {type === "deposit" ? (
          <>
            <KPI
              title="Total Deposits"
              value={fmt(
                current.summary.totalDeposits
              )}
              sub={`Selected date: ${current.dates[selectedDate]}`}
              icon={
                <AccountBalance fontSize="small" />
              }
            />

            <KPI
              title="CASA Ratio"
              value={pct(
                current.summary.casaRatio
              )}
              sub="Current CASA position"
              icon={
                <Savings fontSize="small" />
              }
            />

            <KPI
              title="Demand Deposits"
              value={fmt(
                current.summary.demandDeposits
              )}
              sub="Savings + Current + Other"
              icon={
                <AccountBalance fontSize="small" />
              }
            />

            <KPI
              title="Term Deposits"
              value={fmt(
                current.summary.termDeposits
              )}
              sub="Term deposit portfolio"
              icon={
                <CreditCard fontSize="small" />
              }
            />
          </>
        ) : (
          <>
            <KPI
              title="Total Loans"
              value={fmt(
                current.summary.totalLoans
              )}
              sub="Total sanctioned portfolio"
              icon={
                <CreditCard fontSize="small" />
              }
            />

            <KPI
              title="Outstanding Loans"
              value={fmt(
                current.summary.outstandingLoans
              )}
              sub={`As of ${current.dates[selectedDate]}`}
              icon={
                <AccountBalance fontSize="small" />
              }
            />

            <KPI
              title="Loan Growth"
              value={`${current.summary.loanGrowth}%`}
              sub="Year-on-year growth"
              icon={
                <TrendingUp fontSize="small" />
              }
            />

            <KPI
              title="NPA Ratio"
              value={`${current.summary.npaRatio}%`}
              sub="Portfolio quality"
              icon={
                <PieIcon fontSize="small" />
              }
            />
          </>
        )}
      </Box>

      {/* MAIN CHART */}

      <Box
        display="grid"
        gridTemplateColumns={{
          xs: "1fr",
          lg: "1.6fr 1fr"
        }}
        gap={1.5}
        mb={1.5}
      >
        <Panel
          title={
            type === "deposit"
              ? "Trend in Total Deposits"
              : "Trend in Outstanding Loans"
          }
          subtitle="Click any date to view that day's value"
        >
          <ResponsiveContainer
            width="100%"
            height="100%"
          >
            <LineChart data={trendData}>
              <CartesianGrid
                strokeDasharray="3 3"
              />

              <XAxis
                dataKey="date"
                tick={{
                  fontSize: 10
                }}
              />

              <YAxis
                tickFormatter={v =>
                  `₹${(
                    v / 1e12
                  ).toFixed(0)}T`
                }
              />

              <Tooltip
                formatter={v => fmt(v)}
              />

              <Line
                type="monotone"
                dataKey="value"
                stroke="#315B9A"
                strokeWidth={3}
                dot={{
                  r: 5
                }}
                activeDot={{
                  r: 8,
                  onClick: (_, index) =>
                    setSelectedDate(index)
                }}
              />
            </LineChart>
          </ResponsiveContainer>
        </Panel>

        <Panel
          title={
            type === "deposit"
              ? "CASA Ratio"
              : "Loan Portfolio"
          }
          subtitle={
            type === "deposit"
              ? "Current selected position"
              : "Portfolio distribution"
          }
        >
          {type === "deposit" ? (
            <Donut
              value={
                current.casaRatio
              }
            />
          ) : (
            <NestedChart
              data={
                current.loanPortfolio
              }
            />
          )}
        </Panel>
      </Box>


      {/* SECOND ROW */}

      <Box
        display="grid"
        gridTemplateColumns={{
          xs: "1fr",
          md: "1fr 1fr"
        }}
        gap={1.5}
        mb={1.5}
      >
        {type === "deposit" ? (
          <>
            <Panel
              title="Demand Deposits"
              subtitle="Nested banking deposit structure"
            >
              <NestedChart
                data={
                  current.demandDeposits
                }
              />
            </Panel>

            <Panel
              title="Term Deposits"
              subtitle="Nested term deposit structure"
            >
              <NestedChart
                data={
                  current.termDeposits
                }
              />
            </Panel>
          </>
        ) : (
          <>
            <Panel
              title="Loan Portfolio Breakdown"
              subtitle="Retail, Corporate and MSME"
            >
              <NestedChart
                data={
                  current.loanPortfolio
                }
              />
            </Panel>

            <Panel
              title="Loan Trend"
              subtitle="Daily outstanding loan movement"
            >
              <ResponsiveContainer
                width="100%"
                height="100%"
              >
                <BarChart
                  data={trendData}
                >
                  <CartesianGrid
                    strokeDasharray="3 3"
                  />

                  <XAxis
                    dataKey="date"
                    tick={{
                      fontSize: 10
                    }}
                  />

                  <YAxis
                    tickFormatter={v =>
                      `₹${(
                        v / 1e12
                      ).toFixed(0)}T`
                    }
                  />

                  <Tooltip
                    formatter={v =>
                      fmt(v)
                    }
                  />

                  <Bar
                    dataKey="value"
                    fill="#315B9A"
                    radius={[
                      6,
                      6,
                      0,
                      0
                    ]}
                  />
                </BarChart>
              </ResponsiveContainer>
            </Panel>
          </>
        )}
      </Box>

      {/* SELECTED DATE */}

      <Card
        sx={{
          borderRadius: 3,
          mb: 1.5,
          boxShadow:
            "0 2px 12px rgba(0,0,0,0.06)"
        }}
      >
        <CardContent
          sx={{
            display: "flex",
            justifyContent:
              "space-between",
            alignItems: "center",
            flexWrap: "wrap",
            gap: 1
          }}
        >
          <Box>
            <Typography
              fontSize={11}
              color="text.secondary"
            >
              SELECTED DATE
            </Typography>

            <Typography fontWeight={700}>
              {
                current.dates[
                  selectedDate
                ]
              }
            </Typography>
          </Box>

          <Typography
            fontSize={{
              xs: 20,
              md: 26
            }}
            fontWeight={800}
            color="#315B9A"
          >
            {fmt(selectedValue)}
          </Typography>
        </CardContent>
      </Card>

      {/* SHOW MORE */}

      <Box textAlign="center">
        <Button
          onClick={() =>
            setShowMore(v => !v)
          }
          sx={{
            fontWeight: 700
          }}
        >
          {showMore
            ? "Show Less ↑"
            : "Show More ↓"}
        </Button>
      </Box>

      {/* EXTRA ANALYTICS */}

      {showMore && (
        <Box
          display="grid"
          gridTemplateColumns={{
            xs: "1fr",
            md: "1fr 1fr"
          }}
          gap={1.5}
          mt={1.5}
        >
          <Panel
            title={
              type === "deposit"
                ? "CASA Ratio Trend"
                : "Outstanding Loan Trend"
            }
            subtitle="Complete daily movement"
          >
            <ResponsiveContainer
              width="100%"
              height="100%"
            >
              <LineChart
                data={current.dates.map(
                  (date, i) => ({
                    date,

                    value:
                      type === "deposit"
                        ? current
                            .casaRatioTrend[
                            i
                          ] * 100
                        : current
                            .loanTrend[i]
                  })
                )}
              >
                <CartesianGrid
                  strokeDasharray="3 3"
                />

                <XAxis
                  dataKey="date"
                  tick={{
                    fontSize: 10
                  }}
                />

                <YAxis
                  tickFormatter={v =>
                    type === "deposit"
                      ? `${v}%`
                      : `₹${(
                          v / 1e12
                        ).toFixed(0)}T`
                  }
                />

                <Tooltip
                  formatter={v =>
                    type === "deposit"
                      ? `${v.toFixed(
                          2
                        )}%`
                      : fmt(v)
                  }
                />

                <Line
                  type="monotone"
                  dataKey="value"
                  stroke="#4E78B7"
                  strokeWidth={3}
                  dot
                />
              </LineChart>
            </ResponsiveContainer>
          </Panel>

          <Panel
            title={
              type === "deposit"
                ? "Deposit Composition"
                : "Loan Composition"
            }
            subtitle="Portfolio-level distribution"
          >
            <ResponsiveContainer
              width="100%"
              height="100%"
            >
              <BarChart
                layout="vertical"
                data={
                  type === "deposit"
                    ? current
                        .demandDeposits
                        .children
                    : current
                        .loanPortfolio
                        .children
                }
                margin={{
                  left: 20,
                  right: 20
                }}
              >
                <CartesianGrid
                  strokeDasharray="3 3"
                />

                <XAxis
                  type="number"
                  tickFormatter={v =>
                    `₹${(
                      v / 1e12
                    ).toFixed(0)}T`
                  }
                />

                <YAxis
                  type="category"
                  dataKey="name"
                  width={120}
                  tick={{
                    fontSize: 10
                  }}
                />

                <Tooltip
                  formatter={v =>
                    fmt(v)
                  }
                />

                <Bar
                  dataKey="value"
                  fill="#315B9A"
                  radius={[
                    0,
                    6,
                    6,
                    0
                  ]}
                />
              </BarChart>
            </ResponsiveContainer>
          </Panel>
        </Box>
      )}
    </Box>
  );
}