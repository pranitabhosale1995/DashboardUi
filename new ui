                        justifyContent: "space-between",
                        alignItems: "center"
                      }}
                    >

                      <Typography
                        sx={{
                          fontSize: 11,
                          color: "#6B778C",
                          fontWeight: 600,
                          textTransform: "uppercase",
                          letterSpacing: "0.4px"
                        }}
                      >
                        {item.label}
                      </Typography>


                      <Box
                        sx={{
