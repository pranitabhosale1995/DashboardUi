          ========================================================= */}

      {(() => {

        // ---------------------------------------------------------
        // Convert nested JSON -> leaf nodes for Treemap
        // No name-based mapping. Everything is index based.
        // ---------------------------------------------------------

        const getLeafNodes = (node, result = []) => {

          if (!node) {
            return result;
          }

          if (Array.isArray(node.children) && node.children.length > 0) {

            node.children.forEach((child) => {
              getLeafNodes(child, result);
            });

          } else {

            result.push({
              name: node.name,
              value: Number(node.value) || 0
            });

          }

          return result;
        };


        // ---------------------------------------------------------
        // CURRENT PORTFOLIO
        // ---------------------------------------------------------

        const portfolio =
          type === "deposit"
            ? current?.demandDeposits && current?.termDeposits
              ? {
                  name: "Deposits",
                  children: [
                    ...(current.demandDeposits.children || []),
                    ...(current.termDeposits.children || [])
                  ]
                }
              : null
            : current?.loanPortfolio;


        const portfolioData = getLeafNodes(portfolio);


        // ---------------------------------------------------------
        // BANKING COLORS
        // Index based - independent of database names
        // ---------------------------------------------------------

        const bankingColors = [
          "#1769AA",
          "#2E7D6B",
          "#D99A2B",
          "#5B6FB5",
          "#00838F",
          "#6A5ACD",
          "#C66A2B",
          "#3F7CAC"
        ];


        // ---------------------------------------------------------
        // FORMAT LARGE BANKING VALUES
        // ---------------------------------------------------------

        const formatValue = (value) => {

          const num = Number(value) || 0;

          if (num >= 1000000000000) {
            return `₹${(num / 1000000000000).toFixed(2)} T`;
          }

          if (num >= 1000000000) {
            return `₹${(num / 1000000000).toFixed(2)} B`;
          }

          if (num >= 1000000) {
            return `₹${(num / 1000000).toFixed(2)} M`;
          }

          return `₹${num.toLocaleString("en-IN")}`;
        };


        // ---------------------------------------------------------
        // CUSTOM TREEMAP CONTENT
        // ---------------------------------------------------------

        const renderTreemap = (props) => {

          const {
            x,
            y,
            width,
            height,
            index,
            name,
            value
          } = props;

          if (
            width <= 0 ||
            height <= 0
          ) {
            return null;
          }


          const color =
            bankingColors[index % bankingColors.length];


          const showText =
            width > 105 &&
            height > 65;


          return (
            <g>

              <rect
                x={x}
                y={y}
                width={width}
                height={height}
                rx={6}
                ry={6}
                fill={color}
                stroke="#ffffff"
                strokeWidth={3}
              />


              {showText && (
                <>
                  <text
                    x={x + 14}
                    y={y + height / 2 - 8}
                    fill="#ffffff"
                    fontSize={14}
                    fontWeight={700}
                  >
                    {name}
                  </text>

                  <text
                    x={x + 14}
                    y={y + height / 2 + 15}
                    fill="rgba(255,255,255,0.88)"
                    fontSize={12}
                    fontWeight={500}
                  >
                    {formatValue(value)}
                  </text>
                </>
              )}

            </g>
          );
        };


        // ---------------------------------------------------------
        // KPI DATA
        // ---------------------------------------------------------

        const summary = current?.summary || {};

