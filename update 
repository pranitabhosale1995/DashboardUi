const treemapContent = ({
  x,
  y,
  width,
  height,
  index,
  name,
  colors
}) => {
  if (
    width <= 0 ||
    height <= 0
  ) {
    return null;
  }

  const color =
    colors[
      Number(index || 0) %
        colors.length
    ];

  const showName =
    width > 70 &&
    height > 40;

  return (
    <g>
      <rect
        x={x}
        y={y}
        width={width}
        height={height}
        rx={6}
        ry={6}
        fill={color}
        stroke="#ffffff"
        strokeWidth={2}
      />

      {showName && (
        <text
          x={x + 8}
          y={y + 18}
          fill="#ffffff"
          fontSize={
            width > 130
              ? 11
              : 9
          }
          fontWeight="700"
        >
          {String(name).length >
          18
            ? `${String(
                name
              ).slice(0, 17)}…`
            : name}
        </text>
      )}
    </g>
  );
};

