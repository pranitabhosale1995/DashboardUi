const formatValue = (value) => {
  const number = Number(value || 0);

  if (Math.abs(number) >= 1e12) {
    return `₹${(number / 1e12).toFixed(2)} T`;
  }

  if (Math.abs(number) >= 1e9) {
    return `₹${(number / 1e9).toFixed(2)} B`;
  }

  if (Math.abs(number) >= 1e6) {
    return `₹${(number / 1e6).toFixed(2)} M`;
  }

  if (Math.abs(number) >= 1e3) {
    return `₹${(number / 1e3).toFixed(2)} K`;
  }

  return `₹${number.toLocaleString("en-IN")}`;
};

const formatTrillion = (value) => {
  return `₹${(Number(value || 0) / 1e12).toFixed(1)}T`;
};

const formatPercent = (value) => {
  return `${Number(value || 0).toFixed(1)}%`;
};

const formatDate = (value) => {
  if (!value) {
    return "";
  }

  const parts = String(value).split("-");

  if (parts.length !== 3) {
    return value;
  }

  return `${parts[0]} ${parts[1]}`;
};

const buildTrendData = (current, type) => {
  const dates = current?.dates || [];

  const values =
    type === "deposit"
      ? current?.totalDepositTrend || []
      : current?.loanTrend || [];

  return dates.map((date, index) => ({
    index,
    date,
    label: formatDate(date),
    value: Number(values[index] || 0)
  }));
};

const buildCasaTrendData = (deposit) => {
  const dates = deposit?.dates || [];
  const values = deposit?.casaRatioTrend || [];

  return dates.map((date, index) => ({
    index,
    date,
    label: formatDate(date),
    value: Number(values[index] || 0) * 100
  }));
};

const buildChildrenData = (node) => {
  const children = node?.children || [];

  return children.map((item, index) => ({
    index,
    name:
      item?.name ||
      `Category ${index + 1}`,
    value: Number(item?.value || 0),
    children: item?.children || []
  }));
};

const buildLoanData = (loan) => {
  const children =
    loan?.loanPortfolio?.children || [];

  return children.map((item, index) => ({
    index,
    name:
      item?.name ||
      `Loan ${index + 1}`,
    value: Number(item?.value || 0),
    children: item?.children || []
  }));
};

const buildDepositData = (deposit) => {
  const demand =
    deposit?.demandDeposits?.children || [];

  const term =
    deposit?.termDeposits?.children || [];

  return [
    ...demand.map((item, index) => ({
      index,
      name:
        item?.name ||
        `Demand ${index + 1}`,
      value: Number(item?.value || 0),
      group: "Demand Deposits",
      children: item?.children || []
    })),
    ...term.map((item, index) => ({
      index:
        demand.length + index,
      name:
        item?.name ||
        `Term ${index + 1}`,
      value: Number(item?.value || 0),
      group: "Term Deposits",
      children: item?.children || []
    }))
  ];
};


