function DepositsTreemap({ depositData }) {
  return (
    <ResponsiveContainer width="100%" height="100%">
      <Treemap
        data={depositData}
        dataKey="value"
        nameKey="name"
        stroke="#ffffff"
        aspectRatio={1.8}
        content={({ x, y, width, height, name, value }) => {
          if (width <= 0 || height <= 0) return null;

          return (
            <g>
              <rect
                x={x}
                y={y}
                width={width}
                height={height}
                fill="#315B9A"
                stroke="#ffffff"
                strokeWidth={2}
                rx={4}
              />

              {width > 70 && height > 40 && (
                <>
                  <text
                    x={x + 10}
                    y={y + height - 18}
                    fill="#fff"
                    fontSize={12}
                    fontWeight={600}
                  >
                    {name}
                  </text>

                  <text
                    x={x + 10}
                    y={y + height - 5}
                    fill="#fff"
                    fontSize={10}
                  >
                    ₹{(value / 1e12).toFixed(2)}T
                  </text>
                </>
              )}
            </g>
          );
        }}
      >
        <Tooltip
          formatter={(value) =>
            `₹${(value / 1e12).toFixed(2)}T`
          }
        />
      </Treemap>
    </ResponsiveContainer>
  );
}

