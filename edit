            <Typography
              sx={{
                fontWeight: 700,
                color: "#374151",
              }}
            >
              Loan Portfolio
            </Typography>

            <Typography
              sx={{
                fontSize: 12,
                color: "#9CA3AF",
                mt: 0.5,
