import React, { useMemo, useState } from "react";

import {
  Box,
  Card,
  CardContent,
  Typography,
  ToggleButton,
  ToggleButtonGroup,
  Button,
  Chip
} from "@mui/material";

import {
  Refresh,
  AccountBalance,
  Savings,
  CreditCard,
  TrendingUp,
  PieChart as PieIcon
} from "@mui/icons-material";

import {
  ResponsiveContainer,
  LineChart,
  Line,
  XAxis,
  YAxis,
  CartesianGrid,
  Tooltip,
  Treemap
} from "recharts";

import data from "./bankingData.json";


export default function Dashboard() {

  // =========================================================
  // STATE
  // =========================================================

  const [type, setType] = useState("deposit");

  const [selectedDate, setSelectedDate] = useState(4);

  const [showMore, setShowMore] = useState(false);


  // =========================================================
  // CURRENT DATA
  // =========================================================

  const current = data[type];


  // =========================================================
  // TREND DATA
  // =========================================================

  const trendData = useMemo(() => {

    if (!current?.dates) {
      return [];
    }

    return current.dates.map((date, index) => ({
      date,

      value:
        type === "deposit"
          ? current.totalDepositTrend?.[index] ?? 0
          : current.loanTrend?.[index] ?? 0
    }));

  }, [current, type]);


  // =========================================================
  // SELECTED DATE VALUE
  // =========================================================

  const selectedValue =
    type === "deposit"
      ? current?.totalDepositTrend?.[selectedDate] ?? 0
      : current?.loanTrend?.[selectedDate] ?? 0;


  // =========================================================
  // DEPOSIT / LOAN SWITCH
  // =========================================================

  const handleType = (_, value) => {

    if (!value) {
      return;
    }

    setType(value);
    setSelectedDate(4);
    setShowMore(false);
  };


  // =========================================================
  // GET LEAF NODES
  // =========================================================
  // Important:
  // Database/API madhun names change zale tari code break honar nahi.
  // Children recursively loop hotil.
  // =========================================================

  const getLeafNodes = (node, result = []) => {

    if (!node) {
      return result;
    }

    if (
      Array.isArray(node.children) &&
      node.children.length > 0
    ) {

      node.children.forEach((child) => {
        getLeafNodes(child, result);
      });

    } else {

      result.push({
        name: node.name,
        value: Number(node.value) || 0
      });

    }

    return result;
  };


  // =========================================================
  // PORTFOLIO DATA
  // =========================================================

  const portfolio =
    type === "deposit"
      ? {
          name: "Deposits",

          children: [
            ...(current?.demandDeposits?.children || []),
            ...(current?.termDeposits?.children || [])
          ]
        }

      : current?.loanPortfolio;


  // =========================================================
  // FLATTEN JSON FOR TREEMAP
  // =========================================================

  const portfolioData = useMemo(() => {

    return getLeafNodes(portfolio, []);

  }, [portfolio]);


  // =========================================================
  // BANKING THEME COLORS
  // =========================================================
  // Index based colors.
  // Names hardcode kelelya nahit.
  // =========================================================

  const bankingColors = [
    "#1769AA",
    "#2E7D6B",
    "#D99A2B",
    "#5B6FB5",
    "#00838F",
    "#6A5ACD",
    "#C66A2B",
    "#3F7CAC"
  ];


  // =========================================================
  // FORMAT BANKING VALUES
  // =========================================================

  const formatValue = (value) => {

    const num = Number(value) || 0;

    if (num >= 1000000000000) {
      return `₹${(num / 1000000000000).toFixed(2)} T`;
    }

    if (num >= 1000000000) {
      return `₹${(num / 1000000000).toFixed(2)} B`;
    }

    if (num >= 1000000) {
      return `₹${(num / 1000000).toFixed(2)} M`;
    }

    if (num >= 1000) {
      return `₹${(num / 1000).toFixed(2)} K`;
    }

    return `₹${num.toLocaleString("en-IN")}`;
  };


  // =========================================================
  // CUSTOM TREEMAP
  // =========================================================

  const renderTreemap = (props) => {

    const {
      x,
      y,
      width,
      height,
      index,
      name,
      value
    } = props;


    if (
      width <= 0 ||
      height <= 0
    ) {
      return null;
    }


    const color =
      bankingColors[
        index % bankingColors.length
      ];


    const showText =
      width > 105 &&
      height > 65;


    return (
      <g>

        <rect
          x={x}
          y={y}
          width={width}
          height={height}
          rx={6}
          ry={6}
          fill={color}
          stroke="#FFFFFF"
          strokeWidth={3}
        />


        {showText && (
          <>

            <text
              x={x + 14}
              y={y + height / 2 - 7}
              fill="#FFFFFF"
              fontSize={14}
              fontWeight={700}
            >
              {name}
            </text>


            <text
              x={x + 14}
              y={y + height / 2 + 16}
              fill="rgba(255,255,255,0.88)"
              fontSize={12}
              fontWeight={500}
            >
              {formatValue(value)}
            </text>

          </>
        )}

      </g>
    );
  };


  // =========================================================
  // SUMMARY
  // =========================================================

  const summary = current?.summary || {};


  // =========================================================
  // KPI DATA
  // =========================================================

  const kpiItems =
    type === "deposit"

      ? [

          {
            label: "Total Deposits",
            value: formatValue(summary.totalDeposits),
            icon: <AccountBalance fontSize="small" />
          },

          {
            label: "CASA Ratio",
            value:
              `${((summary.casaRatio || 0) * 100).toFixed(1)}%`,
            icon: <Savings fontSize="small" />
          },

          {
            label: "Demand Deposits",
            value: formatValue(summary.demandDeposits),
            icon: <CreditCard fontSize="small" />
          },

          {
            label: "Term Deposits",
            value: formatValue(summary.termDeposits),
            icon: <TrendingUp fontSize="small" />
          }

        ]

      : [

          {
            label: "Total Loans",
            value: formatValue(summary.totalLoans),
            icon: <AccountBalance fontSize="small" />
          },

          {
            label: "Outstanding Loans",
            value: formatValue(summary.outstandingLoans),
            icon: <CreditCard fontSize="small" />
          },

          {
            label: "Loan Growth",
            value: `${summary.loanGrowth || 0}%`,
            icon: <TrendingUp fontSize="small" />
          },

          {
            label: "NPA Ratio",
            value: `${summary.npaRatio || 0}%`,
            icon: <PieIcon fontSize="small" />
          }

        ];


  // =========================================================
  // HEADER
  // =========================================================

  return (

    <Box
      sx={{
        minHeight: "100vh",
        background: "#F5F7FB",
        p: {
          xs: 1.5,
          md: 3
        }
      }}
    >

      {/* =====================================================
          HEADER
          ===================================================== */}

      <Box
        sx={{
          display: "flex",
          justifyContent: "space-between",

          alignItems: {
            xs: "flex-start",
            md: "center"
          },

          flexDirection: {
            xs: "column",
            md: "row"
          },

          gap: 2,
          mb: 2.5
        }}
      >

        {/* TITLE */}

        <Box>

          <Typography
            sx={{
              fontSize: {
                xs: 24,
                md: 30
              },

              fontWeight: 800,

              color: "#17233C",

              letterSpacing: "-0.5px"
            }}
          >

            {type === "deposit"
              ? "DEPOSITS"
              : "LOANS"}

            <Box
              component="span"
              sx={{
                fontWeight: 400,
                ml: 1
              }}
            >
              DASHBOARD
            </Box>

          </Typography>


          <Typography
            sx={{
              fontSize: 12,
              color: "text.secondary",
              mt: 0.3
            }}
          >
            Evaluating banking financial performance
          </Typography>

        </Box>


        {/* RIGHT CONTROLS */}

        <Box
          sx={{
            display: "flex",
            alignItems: "center",
            gap: 1,
            flexWrap: "wrap"
          }}
        >

          {/* FINANCIAL YEAR */}

          <Chip
            label={data.financialYear}
            variant="outlined"
            size="small"
            sx={{
              fontWeight: 600,
              background: "#FFFFFF"
            }}
          />


          {/* DEPOSIT / LOAN */}

          <ToggleButtonGroup
            value={type}
            exclusive
            onChange={handleType}
            size="small"
            sx={{
              background: "#FFFFFF",

              "& .MuiToggleButton-root": {
                textTransform: "none",
                fontSize: 12,
                fontWeight: 600,
                px: 1.5
              },

              "& .Mui-selected": {
                background: "#EAF2F9 !important",
                color: "#1769AA"
              }
            }}
          >

            <ToggleButton value="deposit">
              Deposit
            </ToggleButton>

            <ToggleButton value="loan">
              Loan
            </ToggleButton>

          </ToggleButtonGroup>


          {/* RESET */}

          <Button
            variant="outlined"
            size="small"
            startIcon={<Refresh />}
            onClick={() => {
              setSelectedDate(4);
              setShowMore(false);
            }}
            sx={{
              background: "#FFFFFF",
              textTransform: "none",
              fontSize: 12
            }}
          >
            Reset
          </Button>

        </Box>

      </Box>


      {/* =====================================================
          PART 2 STARTS HERE
          ===================================================== */}

      {/* =====================================================
          KPI CARDS
          ===================================================== */}

      <Box
        sx={{
          display: "grid",

          gridTemplateColumns: {
            xs: "1fr 1fr",
            sm: "repeat(2, 1fr)",
            md: "repeat(4, 1fr)"
          },

          gap: 1.5,
          mb: 2
        }}
      >

        {kpiItems.map((item, index) => (

          <Card
            key={index}
            elevation={0}
            sx={{
              border: "1px solid #E3E8EF",
              borderRadius: 2,
              background: "#FFFFFF",
              minHeight: 92,

              boxShadow:
                "0 2px 8px rgba(20,40,70,0.04)"
            }}
          >

            <CardContent
              sx={{
                p: 1.6,

                "&:last-child": {
                  pb: 1.6
                }
              }}
            >

              <Box
                sx={{
                  display: "flex",
                  justifyContent: "space-between",
                  alignItems: "center"
                }}
              >

                <Typography
                  sx={{
                    fontSize: 11,
                    color: "#6B778C",
                    fontWeight: 600,
                    textTransform: "uppercase",
                    letterSpacing: "0.4px"
                  }}
                >
                  {item.label}
                </Typography>


                <Box
                  sx={{
                    width: 28,
                    height: 28,
                    borderRadius: 1.5,

                    display: "flex",
                    alignItems: "center",
                    justifyContent: "center",

                    background: "#EEF4FA",
                    color: "#1769AA"
                  }}
                >
                  {item.icon}
                </Box>

              </Box>


              <Typography
                sx={{
                  mt: 1,

                  fontSize: {
                    xs: 17,
                    md: 20
                  },

                  fontWeight: 800,
                  color: "#17233C",
                  letterSpacing: "-0.3px"
                }}
              >
                {item.value}
              </Typography>

            </CardContent>

          </Card>

        ))}

      </Box>


      {/* =====================================================
          PORTFOLIO COMPOSITION
          ===================================================== */}

      <Card
        elevation={0}
        sx={{
          border: "1px solid #E1E7EF",
          borderRadius: 2.5,
          background: "#FFFFFF",
          overflow: "hidden",
          mb: 2
        }}
      >

        {/* CARD HEADER */}

        <Box
          sx={{
            px: {
              xs: 2,
              md: 2.5
            },

            py: 1.7,

            display: "flex",
            justifyContent: "space-between",
            alignItems: "center",

            borderBottom:
              "1px solid #EDF0F4"
          }}
        >

          <Box>

            <Typography
              sx={{
                fontSize: 17,
                fontWeight: 800,
                color: "#17233C"
              }}
            >
              {type === "deposit"
                ? "Deposit Portfolio"
                : "Loan Portfolio"}
            </Typography>


            <Typography
              sx={{
                fontSize: 11,
                color: "#7A869A",
                mt: 0.3
              }}
            >
              Portfolio composition
            </Typography>

          </Box>


          <Chip
            icon={
              <PieIcon
                sx={{
                  fontSize: 15
                }}
              />
            }

            label={`${portfolioData.length} categories`}

            size="small"

            sx={{
              background: "#F3F6FA",
              color: "#536174",
              fontSize: 11,
              fontWeight: 600
            }}
          />

        </Box>


        {/* =================================================
            TREEMAP
            ================================================= */}

        <Box
          sx={{
            height: {
              xs: 300,
              sm: 340,
              md: 365
            },

            px: {
              xs: 1,
              md: 2
            },

            py: 1.5
          }}
        >

          <ResponsiveContainer
            width="100%"
            height="100%"
          >

            <Treemap
              data={portfolioData}
              dataKey="value"
              nameKey="name"
              aspectRatio={2.15}
              stroke="#FFFFFF"
              content={renderTreemap}
            >

              <Tooltip
                formatter={(value, name) => [
                  formatValue(value),
                  name
                ]}

                contentStyle={{
                  borderRadius: 8,
                  border: "1px solid #DCE2EA",
                  boxShadow:
                    "0 5px 20px rgba(0,0,0,0.08)",
                  fontSize: 12
                }}
              />

            </Treemap>

          </ResponsiveContainer>

        </Box>


        {/* =================================================
            DYNAMIC LEGEND
            ================================================= */}

        <Box
          sx={{
            px: {
              xs: 2,
              md: 2.5
            },

            pb: 2,

            display: "flex",
            flexWrap: "wrap",

            gap: {
              xs: 1.2,
              md: 2
            }
          }}
        >

          {portfolioData.map((item, index) => (

            <Box
              key={index}
              sx={{
                display: "flex",
                alignItems: "center",
                gap: 0.7,

                minWidth: {
                  xs: "45%",
                  sm: "auto"
                }
              }}
            >

              <Box
                sx={{
                  width: 8,
                  height: 8,
                  borderRadius: "2px",
                  flexShrink: 0,

                  background:
                    bankingColors[
                      index %
                      bankingColors.length
                    ]
                }}
              />


              <Typography
                sx={{
                  fontSize: 10.5,
                  color: "#657184"
                }}
              >
                {item.name}
              </Typography>

            </Box>

          ))}

        </Box>

      </Card>


      {/* =====================================================
          PERFORMANCE TREND
          ===================================================== */}

      <Card
        elevation={0}
        sx={{
          border: "1px solid #E1E7EF",
          borderRadius: 2.5,
          background: "#FFFFFF",
          mb: 2
        }}
      >

        {/* TREND HEADER */}

        <Box
          sx={{
            px: {
              xs: 2,
              md: 2.5
            },

            py: 1.7,

            display: "flex",
            justifyContent: "space-between",
            alignItems: "center",

            borderBottom:
              "1px solid #EDF0F4"
          }}
        >

          <Box>

            <Typography
              sx={{
                fontSize: 17,
                fontWeight: 800,
                color: "#17233C"
              }}
            >
              {type === "deposit"
                ? "Deposit Trend"
                : "Loan Trend"}
            </Typography>


            <Typography
              sx={{
                fontSize: 11,
                color: "#7A869A",
                mt: 0.3
              }}
            >
              Daily movement
            </Typography>

          </Box>


          <Chip
            label={
              current?.dates?.[selectedDate] || "-"
            }

            size="small"

            sx={{
              background: "#EEF4FA",
              color: "#1769AA",
              fontWeight: 600,
              fontSize: 10.5
            }}
          />

        </Box>


        {/* LINE CHART */}

        <Box
          sx={{
            height: {
              xs: 250,
              md: 285
            },

            px: 1,
            pt: 2,
            pb: 1
          }}
        >

          <ResponsiveContainer
            width="100%"
            height="100%"
          >

            <LineChart
              data={trendData}

              margin={{
                top: 10,
                right: 20,
                left: 10,
                bottom: 5
              }}
            >

              <CartesianGrid
                stroke="#E8EDF3"
                strokeDasharray="4 4"
                vertical={false}
              />


              <XAxis
                dataKey="date"

                tick={{
                  fontSize: 10,
                  fill: "#788397"
                }}

                tickLine={false}

                axisLine={{
                  stroke: "#DCE2EA"
                }}
              />


              <YAxis
                tick={{
                  fontSize: 10,
                  fill: "#788397"
                }}

                tickLine={false}

                axisLine={false}

                tickFormatter={(value) =>
                  `${(
                    value /
                    1000000000000
                  ).toFixed(0)}T`
                }
              />


              <Tooltip
                formatter={(value) => [
                  formatValue(value),

                  type === "deposit"
                    ? "Deposits"
                    : "Loans"
                ]}

                contentStyle={{
                  borderRadius: 8,
                  border:
                    "1px solid #DCE2EA",

                  boxShadow:
                    "0 5px 20px rgba(0,0,0,0.08)",

                  fontSize: 12
                }}
              />


              <Line
                type="monotone"
                dataKey="value"

                stroke="#1769AA"

                strokeWidth={3}

                dot={{
                  r: 3,
                  fill: "#1769AA",
                  strokeWidth: 0
                }}

                activeDot={{
                  r: 6
                }}
              />

            </LineChart>

          </ResponsiveContainer>

        </Box>

      </Card>


      {/* =====================================================
          SELECTED DATE SUMMARY
          ===================================================== */}

      <Card
        elevation={0}
        sx={{
          border: "1px solid #E1E7EF",
          borderRadius: 2.5,
          background: "#FFFFFF"
        }}
      >

        <Box
          sx={{
            px: {
              xs: 2,
              md: 2.5
            },

            py: 1.6,

            display: "flex",
            justifyContent: "space-between",
            alignItems: "center",

            flexWrap: "wrap",
            gap: 1
          }}
        >

          {/* DATE */}

          <Box>

            <Typography
              sx={{
                fontSize: 10,
                color: "#7A869A",
                textTransform: "uppercase",
                fontWeight: 700,
                letterSpacing: "0.5px"
              }}
            >
              Selected Date
            </Typography>


            <Typography
              sx={{
                fontSize: 13,
                fontWeight: 700,
                color: "#344054",
                mt: 0.3
              }}
            >
              {current?.dates?.[selectedDate] || "-"}
            </Typography>

          </Box>


          {/* VALUE */}

          <Box
            sx={{
              textAlign: "right"
            }}
          >

            <Typography
              sx={{
                fontSize: 10,
                color: "#7A869A",
                textTransform: "uppercase",
                fontWeight: 700
              }}
            >
              {type === "deposit"
                ? "Total Deposits"
                : "Outstanding Loans"}
            </Typography>


            <Typography
              sx={{
                fontSize: {
                  xs: 18,
                  md: 21
                },

                fontWeight: 800,
                color: "#1769AA",
                mt: 0.2
              }}
            >
              {formatValue(selectedValue)}
            </Typography>

          </Box>

        </Box>

      </Card>


      {/* =====================================================
          NEXT SECTION PLACEHOLDER
          ===================================================== */}

      <Box
        sx={{
          mt: 2,

          p: 2,

          borderRadius: 2,

          border:
            "1px dashed #D7DEE8",

          background: "#FAFBFC"
        }}
      >

        <Typography
          sx={{
            fontSize: 13,
            fontWeight: 700,
            color: "#526075"
          }}
        >
          Performance Analysis
        </Typography>


        <Typography
          sx={{
            fontSize: 11,
            color: "#8A95A5",
            mt: 0.5
          }}
        >
          Next dashboard section can be connected to API data here.
        </Typography>

      </Box>


    </Box>

  );

}