/* =========================================================
   HELPERS
   ========================================================= */

const formatAmount = (value) => {
  if (
    value === null ||
    value === undefined ||
    Number.isNaN(value)
  ) {
    return "₹0";
  }

  const amount = Number(value);

  if (amount >= 1_000_000_000_000) {
    return `₹${(
      amount / 1_000_000_000_000
    ).toFixed(2)} T`;
  }

  if (amount >= 1_000_000_000) {
    return `₹${(
      amount / 1_000_000_000
    ).toFixed(2)} B`;
  }

  if (amount >= 1_000_000) {
    return `₹${(
      amount / 1_000_000
    ).toFixed(2)} M`;
  }

  if (amount >= 1_000) {
    return `₹${(
      amount / 1_000
    ).toFixed(2)} K`;
  }

  return `₹${amount.toLocaleString("en-IN")}`;
};


/*
 * Dynamic recursive loop.
 *
 * IMPORTANT:
 * कोणत्याही category चे name hardcode केलेले नाही.
 *
 * API / database मधून name change झाले
 * तरी graph automatically नवीन name घेईल.
 */
const getLeafNodes = (
  node,
  parentPath = []
) => {
  if (!node) return [];

  const children = Array.isArray(node.children)
    ? node.children
    : [];

  if (children.length === 0) {
    return [
      {
        ...node,
        path: parentPath,
      },
    ];
  }

  return children.flatMap(
    (child, index) =>
      getLeafNodes(
        child,
        [...parentPath, index]
      )
  );
};


/*
 * Generic value getter.
 *
 * Name वर dependency नाही.
 */
const getNodeValue = (node) => {
  if (!node) return 0;

  if (
    typeof node.value === "number" &&
    Number.isFinite(node.value)
  ) {
    return node.value;
  }

  if (Array.isArray(node.children)) {
    return node.children.reduce(
      (sum, child) =>
        sum + getNodeValue(child),
      0
    );
  }

  return 0;
};


/* =========================================================
   TREEMAP LAYOUT
   ========================================================= */

const buildTreemap = (
  items,
  x,
  y,
  width,
  height,
  depth = 0
) => {
  if (!items || items.length === 0) {
    return [];
  }

  const total = items.reduce(
    (sum, item) =>
      sum +
      Math.max(
        Number(item.value) || 0,
        0
      ),
    0
  );

  if (!total) return [];

  const result = [];

  let offset = 0;

  items.forEach((item, index) => {
    const value = Math.max(
      Number(item.value) || 0,
      0
    );

    if (value <= 0) return;

    const ratio = value / total;

    let rect;

    /*
     * Index/depth वरून direction बदलतो.
     */
    if (depth % 2 === 0) {
      const itemWidth =
        width * ratio;

      rect = {
        x: x + offset,
        y,
        width: itemWidth,
        height,
      };

      offset += itemWidth;
    } else {
      const itemHeight =
        height * ratio;

      rect = {
        x,
        y: y + offset,
        width,
        height: itemHeight,
      };

      offset += itemHeight;
    }

    result.push({
      ...item,
      ...rect,
      index,
    });
  });

  return result;
};


/* =========================================================
   DEPOSIT TREEMAP
   ========================================================= */

function DepositsTreemap({ data }) {
  const leaves = useMemo(() => {
