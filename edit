    "#2563EB",
    "#F97316",
    "#10B981",
    "#EAB308",
    "#06B6D4",
    "#84CC16",
    "#6366F1",
    "#EC4899",
    "#14B8A6",
    "#8B5CF6",
  ];


  return (
    <Paper
      elevation={0}
      sx={{
        border:
          "1px solid #E5E7EB",
        borderRadius: 3,
        overflow: "hidden",
        background: "#FFFFFF",
      }}
    >

      {/* GRAPH HEADER */}

      <Box
        sx={{
          px: {
            xs: 2,
            md: 2.5,
          },
          pt: 2.2,
          pb: 1.5,
        }}
      >
        <Typography
          sx={{
            fontSize: {
              xs: 18,
              md: 20,
            },
            fontWeight: 700,
            color: "#111827",
          }}
        >
          Deposits
        </Typography>

        <Typography
          sx={{
            fontSize: 12,
            color: "#6B7280",
            mt: 0.4,
          }}
        >
          Deposit portfolio composition
        </Typography>
      </Box>


      {/* TREEMAP */}

      <Box
        sx={{
          width: "100%",
          px: 1.5,
          pb: 1.5,
        }}
      >
        <Box
          sx={{
            width: "100%",
            height: {
              xs: 350,
              sm: 400,
              md: 460,
            },
            borderRadius: 2,
            overflow: "hidden",
            background: "#F8FAFC",
          }}
        >

          <svg
            viewBox="0 0 1000 460"
            width="100%"
            height="100%"
            preserveAspectRatio="none"
          >

            {rectangles.map(
              (item, index) => {
                const fill =
                  colors[
                    index %
                      colors.length
                  ];

                const showLabel =
                  item.width > 110 &&
                  item.height > 55;

                const showValue =
                  item.width > 145 &&
                  item.height > 75;

                return (
                  <g
                    key={`${item.path.join(
                      "-"
                    )}-${index}`}
                  >

                    <rect
                      x={item.x}
                      y={item.y}
                      width={Math.max(
                        item.width - 2,
                        0
                      )}
                      height={Math.max(
                        item.height - 2,
                        0
                      )}
                      rx="3"
                      fill={fill}
                      stroke="#FFFFFF"
                      strokeWidth="2"
                    />


                    {showLabel && (
                      <text
                        x={
                          item.x + 14
                        }
                        y={
                          item.y +
                          item.height /
                            2 -
                          5
                        }
                        fill="#FFFFFF"
                        fontSize="16"
                        fontWeight="600"
                      >
                        {item.name}
                      </text>
                    )}


                    {showValue && (
                      <text
                        x={
                          item.x + 14
                        }
                        y={
                          item.y +
                          item.height /
                            2 +
                          18
                        }
                        fill="rgba(255,255,255,0.85)"
                        fontSize="12"
                      >
                        {formatAmount(
                          item.value
                        )}
                      </text>
                    )}


                    <title>
                      {item.name}:{" "}
                      {formatAmount(
                        item.value
                      )}
                    </title>

                  </g>
                );
              }
            )}

          </svg>

        </Box>
      </Box>


      {/* DYNAMIC LEGEND */}

      <Box
        sx={{
          px: 2.5,
          pb: 2.5,
          display: "flex",
          flexWrap: "wrap",
          gap: 1.2,
