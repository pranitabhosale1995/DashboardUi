     * Demand + Term दोन्ही JSON मधून घेतले आहेत.
     *
     * कोणतेही name hardcode नाही.
     */
    const roots = [
      data?.deposit?.demandDeposits,
      data?.deposit?.termDeposits,
    ];

    return roots.flatMap(
      (root, rootIndex) =>
        getLeafNodes(
          root,
          [rootIndex]
        )
    );
  }, [data]);


  const rectangles = useMemo(() => {
    return buildTreemap(
      leaves,
      0,
      0,
      1000,
      460
    );
  }, [leaves]);


  /*
   * Colour index वरून.
   *
   * Category name वर dependency नाही.
   */
