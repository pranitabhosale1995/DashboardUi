const first = (...values) => {
  for (const value of values) {
    if (value !== undefined && value !== null && value !== "") {
      return value;
    }
  }
  return null;
};

const numberValue = value => {
  if (typeof value === "number") return value;
  if (typeof value === "string") {
    const clean = value.replace(/[^0-9.-]/g, "");
    const parsed = Number(clean);
    return Number.isFinite(parsed) ? parsed : 0;
  }
  return 0;
};

const formatAmount = value => {
  const n = numberValue(value);

  if (Math.abs(n) >= 1e12) {
    return `₹ ${(n / 1e12).toFixed(2)} T`;
  }

  if (Math.abs(n) >= 1e9) {
    return `₹ ${(n / 1e9).toFixed(2)} B`;
  }

  if (Math.abs(n) >= 1e6) {
    return `₹ ${(n / 1e6).toFixed(2)} M`;
  }

  if (Math.abs(n) >= 1e3) {
    return `₹ ${(n / 1e3).toFixed(2)} K`;
  }

  return `₹ ${n.toFixed(2)}`;
};

const formatCompact = value => {
  const n = numberValue(value);

  if (Math.abs(n) >= 1e12) {
    return `${(n / 1e12).toFixed(2)} T`;
  }

  if (Math.abs(n) >= 1e9) {
    return `${(n / 1e9).toFixed(2)} B`;
  }

  if (Math.abs(n) >= 1e6) {
    return `${(n / 1e6).toFixed(2)} M`;
  }

  if (Math.abs(n) >= 1e3) {
    return `${(n / 1e3).toFixed(2)} K`;
  }

  return n.toFixed(2);
};

const formatPercent = value => {
  const n = numberValue(value);
  return `${n.toFixed(1)}%`;
};

const normalizeArray = value => {
  if (Array.isArray(value)) return value;
  if (value && typeof value === "object") {
    return Object.entries(value).map(([name, amount]) => ({
      name,
      value: numberValue(amount)
    }));
  }
  return [];
};

const getArray = (source, keys = []) => {
  if (!source) return [];

  for (const key of keys) {
    const value = source[key];

    if (Array.isArray(value)) {
      return value;
    }

    if (value && typeof value === "object") {
      return Object.entries(value).map(([name, amount]) => ({
        name,
        value: numberValue(amount)
      }));
    }
  }

  return [];
};

const getNumber = (source, keys = [], index = null) => {
  if (!source) return 0;

  for (const key of keys) {
    const value = source[key];

    if (Array.isArray(value) && index !== null) {
      return numberValue(value[index]);
    }

    if (!Array.isArray(value) && typeof value !== "object") {
      return numberValue(value);
    }
  }

  return 0;
};

const getName = item => {
  if (!item) return "";

  if (typeof item === "string") {
    return item;
  }

  return first(
    item.name,
    item.label,
    item.title,
    item.accountName,
    item.category,
    item.type,
    item.depositType,
    item.loanType,
    "Category"
  );
};

const getValue = item => {
  if (!item) return 0;

  if (typeof item === "number") {
    return item;
  }

  if (typeof item === "string") {
    return numberValue(item);
  }

  return numberValue(
    first(
      item.value,
      item.amount,
      item.balance,
      item.total,
      item.deposit,
      item.loan,
      item.currentValue
    )
  );
};

const getChildren = item => {
  if (!item || typeof item !== "object") return [];

  return normalizeArray(
    first(
      item.children,
      item.items,
      item.subCategories,
      item.subcategories,
      item.details,
      item.breakdown
    )
  );
};

const extractItems = (source, keys) => {
  const raw = getArray(source, keys);

  return raw
    .map(item => ({
      name: getName(item),
      value: getValue(item),
      children: getChildren(item)
    }))
    .filter(item => item.name);
};

