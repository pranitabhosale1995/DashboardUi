import React from "react";
import {
 Box,Card,Typography,Stack,Button,Select,MenuItem,
 ToggleButton,ToggleButtonGroup,Grid,Paper
} from "@mui/material";
import {
 AccountBalance,AccountBalanceWallet,Description,Percent,
 TrendingUp,Lightbulb,Groups,ShowChart,Refresh,CalendarMonth
} from "@mui/icons-material";
import {
 ResponsiveContainer,LineChart,Line,CartesianGrid,XAxis,YAxis,Tooltip,
 PieChart,Pie,Cell,BarChart,Bar,AreaChart,Area,Legend
} from "recharts";
import data from "./data/deposits.json";

const purple="#6635d8",dark="#21105f";
const colors=["#4bb58a","#ffd83d","#ef476f"];

const CardBox=({children,sx={}})=>
<Card sx={{p:2,borderRadius:3,boxShadow:"0 4px 20px #4b328018",...sx}}>
{children}</Card>;

const Icon=({type})=>{
 const m={
  deposit:<AccountBalanceWallet/>,
  bank:<AccountBalance/>,
  term:<Description/>,
  percent:<Percent/>,
  up:<TrendingUp/>,
  users:<Groups/>,
  chart:<ShowChart/>
 };
 return React.cloneElement(m[type]||<ShowChart/>,{sx:{color:purple}});
};

function Stat({x}){
 return <CardBox><Stack direction="row" alignItems="center" spacing={1.5}>
  <Box sx={{p:1.2,bgcolor:"#eee7ff",borderRadius:2}}><Icon type={x.icon}/></Box>
  <Box flex={1}>
   <Typography fontWeight={700}>{x.title}</Typography>
   <Typography fontSize={28} fontWeight={900} color={dark}>{x.value}</Typography>
  </Box>
  <Box textAlign="right" color="#159669">
   <b>▲ {x.up}</b><Typography fontSize={11} color="text.secondary">vs previous period</Typography>
  </Box>
 </Stack></CardBox>
}

const axis={fontSize:10,fill:"#302460"};

function Title({icon,title,sub}){
 return <Stack direction="row" spacing={1} alignItems="center" mb={1}>
  <Icon type={icon}/><Box><Typography fontWeight={900} color="#38117d">{title}</Typography>
  {sub&&<Typography fontSize={12} color="text.secondary">{sub}</Typography>}</Box>
 </Stack>
}

function Trend({dataKey="v",data:chartData}){
 return <ResponsiveContainer width="100%" height={215}>
  <LineChart data={chartData}>
   <CartesianGrid stroke="#ddd" strokeDasharray="2 3"/>
   <XAxis dataKey="d" tick={axis}/>
   <YAxis tick={axis}/>
   <Tooltip/>
   <Line type="monotone" dataKey={dataKey} stroke={purple} strokeWidth={3} dot={{r:3}}/>
  </LineChart>
 </ResponsiveContainer>
}

function Bars({chartData}){
 return <ResponsiveContainer width="100%" height={210}>
  <BarChart data={chartData} margin={{top:20}}>
   <CartesianGrid stroke="#ddd"/>
   <XAxis dataKey="name" tick={{...axis,angle:-12,textAnchor:"end"}} height={55}/>
   <YAxis tick={axis}/>
   <Tooltip/>
   <Bar dataKey="value" fill={purple} radius={[5,5,0,0]}/>
  </BarChart>
 </ResponsiveContainer>
}

function App(){
 return <Box sx={{minHeight:"100vh",p:2.5,bg:"transparent"}}>
  <Stack direction="row" alignItems="center" spacing={2} mb={2}>
   <Box flex={1}>
    <Typography fontSize={30} fontWeight={900} color={dark}>Deposits Dashboard</Typography>
    <Typography color="#665b98">Deposit portfolio overview and trend analysis</Typography>
   </Box>

   <ToggleButtonGroup exclusive value="deposits" size="small">
    <ToggleButton value="deposits">Deposits</ToggleButton>
    <ToggleButton value="loans">Loans</ToggleButton>
   </ToggleButtonGroup>

   <Typography fontSize={13}>Financial Year</Typography>
   <Select size="small" value="2025-26"><MenuItem value="2025-26">2025-26</MenuItem></Select>
   <Button startIcon={<CalendarMonth/>} variant="outlined">27-Jul-2025 ~ 10-Aug-2025</Button>
   <Button variant="contained" startIcon={<Refresh/>}>Reset</Button>
  </Stack>

  <Grid container spacing={1.5} mb={1.5}>
   {data.stats.map((x,i)=><Grid size={{xs:12,sm:6,md:3}} key={i}><Stat x={x}/></Grid>)}
  </Grid>

  <Grid container spacing={1.5}>
   <Grid size={{xs:12,md:5}}>
    <CardBox>
     <Title icon="chart" title="TREND IN CASA RATIO"/>
     <Stack direction="row" justifyContent="flex-end" mb={1}>
      <ToggleButtonGroup exclusive value="Daily" size="small">
       <ToggleButton value="Daily">Daily</ToggleButton>
       <ToggleButton value="Weekly">Weekly</ToggleButton>
       <ToggleButton value="Monthly">Monthly</ToggleButton>
      </ToggleButtonGroup>
     </Stack>
     <Trend chartData={data.casaTrend}/>
    </CardBox>
   </Grid>

   <Grid size={{xs:12,md:3}}>
    <CardBox>
     <Title icon="percent" title="CASA Ratio" sub="Current portfolio mix"/>
     <ResponsiveContainer width="100%" height={215}>
      <PieChart>
       <Pie data={data.casaRatio} dataKey="value" innerRadius={55} outerRadius={85} startAngle={180} endAngle={0}>
        {data.casaRatio.map((_,i)=><Cell key={i} fill={colors[i]}/>)}
       </Pie>
      </PieChart>
     </ResponsiveContainer>
     <Typography textAlign="center" fontSize={28} fontWeight={900} color={dark}>29.0%</Typography>
     <Typography textAlign="center">CASA Ratio</Typography>
    </CardBox>
   </Grid>

   <Grid size={{xs:12,md:4}}>
    <CardBox>
     <Title icon="deposit" title="Deposits" sub="Composition by category (₹ T)"/>
     <Bars chartData={data.deposits}/>
    </CardBox>
   </Grid>

   <Grid size={{xs:12,md:4}}>
    <CardBox><Title icon="bank" title="Demand Deposits"/>
     <Bars chartData={data.demandDeposits}/>
    </CardBox>
   </Grid>

   <Grid size={{xs:12,md:4}}>
    <CardBox><Title icon="term" title="TERM DEPOSITS"/>
     <Bars chartData={data.termDeposits}/>
    </CardBox>
   </Grid>

   <Grid size={{xs:12,md:4}}>
    <CardBox><Title icon="chart" title="TOTAL DEPOSITS"/>
     <Trend chartData={data.totalDeposits}/>
    </CardBox>
   </Grid>

   <Grid size={{xs:12,md:8}}>
    <CardBox>
     <Title icon="chart" title="Special Term Deposit Forecast for next 7 Days"/>
     <ResponsiveContainer width="100%" height={190}>
      <LineChart data={data.forecast}>
       <CartesianGrid stroke="#ddd"/>
       <XAxis dataKey="d" tick={axis}/>
       <YAxis tick={axis}/>
       <Tooltip/>
       <Line dataKey="actual" stroke={purple} strokeWidth={2.5}/>
       <Line dataKey="forecast" stroke="#e34891" strokeDasharray="6 4"/>
       <Line dataKey="lower" stroke="#999" strokeDasharray="5 5"/>
       <Line dataKey="upper" stroke="#555" strokeDasharray="5 5"/>
       <Legend/>
      </LineChart>
     </ResponsiveContainer>
    </CardBox>
   </Grid>

   <Grid size={{xs:12,md:4}}>
    <CardBox>
     <Title icon="up" title="Insights"/>
     {data.insights.map((x,i)=><Paper key={i} sx={{p:1.3,mb:1,borderRadius:2}}>
      <Stack direction="row" spacing={1} alignItems="center">
       <Icon type={x.icon}/><Box>
        <Typography fontWeight={700} fontSize={13}>{x.title}</Typography>
        <Typography fontSize={11} color="text.secondary">{x.sub}</Typography>
       </Box>
      </Stack>
     </Paper>)}
    </CardBox>
   </Grid>
  </Grid>
 </Box>
}

export default App;