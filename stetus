              subtitle="Click any point on the trend chart"
            />

            <Box
              sx={{
                p: 1.5,
                borderRadius: "12px",
                background:
                  "linear-gradient(135deg,#F7F3FF,#F3F7FF)",
                border:
                  "1px solid rgba(118,84,232,.10)"
              }}
            >
              <Stack
                direction="row"
                justifyContent="space-between"
                alignItems="center"
                sx={{ mb: 1.3 }}
              >
                <Box>
                  <Typography
                    sx={{
                      fontSize: 9,
                      color: mutedColor,
                      fontWeight: 700
                    }}
                  >
                    Selected Date
                  </Typography>

                  <Typography
                    sx={{
                      fontSize: 16,
                      color: textColor,
                      fontWeight: 900,
                      mt: .25
                    }}
                  >
                    {selectedTrendDate || "—"}
                  </Typography>
                </Box>

                <Box
                  sx={{
                    width: 44,
                    height: 44,
                    borderRadius: "12px",
                    display: "flex",
                    alignItems: "center",
                    justifyContent: "center",
                    bgcolor: "#EAE3FF",
                    color: purple
                  }}
                >
                  <CalendarMonth />
                </Box>
              </Stack>

              <Box
                sx={{
                  display: "grid",
                  gridTemplateColumns:
                    "repeat(2,minmax(0,1fr))",
                  gap: 1
                }}
              >
                <Box>
                  <Typography
                    sx={{
                      fontSize: 8.5,
                      color: mutedColor,
                      fontWeight: 700
                    }}
                  >
                    {type === "deposit"
                      ? "Total Deposits"
                      : "Total Loans"}
                  </Typography>

                  <Typography
                    sx={{
                      fontSize: 12,
                      color: purple,
                      fontWeight: 900,
                      mt: .25
                    }}
                  >
                    {formatAmount(
                      selectedTotalValue
                    )}
                  </Typography>
                </Box>

                <Box>
                  <Typography
                    sx={{
                      fontSize: 8.5,
                      color: mutedColor,
                      fontWeight: 700
                    }}
                  >
                    {type === "deposit"
                      ? "CASA Ratio"
                      : "Trend Value"}
                  </Typography>

                  <Typography
                    sx={{
                      fontSize: 12,
                      color: textColor,
                      fontWeight: 900,
                      mt: .25
                    }}
                  >
                    {type === "deposit"
                      ? formatPercent(
                          selectedCasaValue
                        )
                      : formatAmount(
                          selectedTotalValue
                        )}
                  </Typography>
                </Box>
              </Box>
            </Box>

            <Stack
              direction="row"
              spacing={.7}
              flexWrap="wrap"
              sx={{ mt: 1 }}
            >
              {dates.map((date, index) => (
                <Chip
                  key={`${date}-${index}`}
                  label={date}
                  size="small"
                  onClick={() =>
                    setSelectedDate(index)
                  }
                  sx={{
                    height: 25,
                    fontSize: 8,
                    fontWeight:
                      selectedDate === index
                        ? 900
                        : 600,
                    color:
                      selectedDate === index
                        ? "#fff"
                        : mutedColor,
                    bgcolor:
                      selectedDate === index
                        ? purple
                        : "#F1F2F7",
                    cursor: "pointer",
                    "&:hover": {
                      bgcolor:
                        selectedDate === index
                          ? "#6039C7"
                          : "#E8E9F0"
                    }
                  }}
                />
              ))}
            </Stack>
          </GlassCard>
        </Box>

        {forecast.length > 0 && (
          <GlassCard
            sx={{
              p: 1.6,
              mb: 1.5
            }}
          >
            <SectionTitle
              icon={
                <TrendingUp
                  sx={{ fontSize: 20 }}
                />
              }
              title="Forecast & Outlook"
              subtitle="Projected portfolio movement"
            />

            <Box sx={{ height: 260 }}>
              <ResponsiveContainer
                width="100%"
                height="100%"
              >
                <LineChart
                  data={forecast}
                  margin={{
                    top: 10,
                    right: 15,
                    left: -15,
                    bottom: 5
                  }}
                >
                  <CartesianGrid
                    strokeDasharray="3 3"
                    stroke="rgba(91,80,150,.12)"
                  />

                  <XAxis
                    dataKey="date"
                    tick={{
                      fontSize: 8,
                      fill: mutedColor
                    }}
                    tickLine={false}
                    axisLine={false}
                  />

                  <YAxis
                    tick={{
                      fontSize: 8,
                      fill: mutedColor
                    }}
                    tickLine={false}
                    axisLine={false}
                    tickFormatter={formatCompact}
                  />

                  <Tooltip
                    contentStyle={{
                      borderRadius: 10,
                      border:
                        `1px solid ${borderColor}`,
                      fontSize: 10
                    }}
                    formatter={value =>
                      formatAmount(value)
                    }
                  />

                  <Legend
                    wrapperStyle={{
                      fontSize: 9
                    }}
                  />

                  <Line
                    type="monotone"
                    dataKey="actual"
                    name="Actual"
                    stroke="#7654E8"
                    strokeWidth={2.5}
                    dot={{ r: 3 }}
                  />

                  <Line
                    type="monotone"
                    dataKey="forecast"
                    name="Forecast"
                    stroke="#4C8BF5"
                    strokeWidth={2.5}
                    strokeDasharray="6 4"
                    dot={{ r: 2 }}
                  />
                </LineChart>
              </ResponsiveContainer>
            </Box>
          </GlassCard>
        )}

        <Box
          sx={{
            display: "flex",
            justifyContent: "space-between",
            alignItems: "center",
            px: .5,
            py: .7
          }}
        >
          <Typography
            sx={{
              fontSize: 8.5,
              color: mutedColor,
              fontWeight: 600
            }}
          >
            Banking Analytics Dashboard
          </Typography>

          <Stack
            direction="row"
            spacing={.5}
            alignItems="center"
          >
            <Box
              sx={{
                width: 6,
                height: 6,
                borderRadius: "50%",
                bgcolor: green
              }}
            />

            <Typography
              sx={{
                fontSize: 8.5,
                color: mutedColor
              }}
            >
              Data loaded from JSON
            </Typography>
          </Stack>
        </Box>
      </Box>
    </Box>
  );
}
