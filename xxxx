export default function Dashboard({
  data = dashboardData,
}) {
  const [refreshKey, setRefreshKey] =
    useState(0);

  const normalizedData = useMemo(
    () => data || {},
    [data]
  );

  const handleReset = () => {
    setRefreshKey(
      (current) => current + 1
    );
  };

  const drilldowns =
    normalizedData.drilldowns || {};

  return (
    <Box
      key={refreshKey}
      sx={{
        minHeight: "100vh",
        position: "relative",
        p: {
          xs: 1.5,
          sm: 2,
          md: 3,
        },
        color:
          theme.palette.text.primary,
      }}
    >
      <DashboardBackground />

      <DashboardHeader
        config={
          normalizedData.header
        }
        onReset={handleReset}
      />

      <DashboardSection title="Deposits">
        <Box
          sx={{
            display: "grid",
            gridTemplateColumns: {
              xs: "1fr",
              lg: "1fr 1.6fr",
            },
            gap: 2.5,
            alignItems: "stretch",
          }}
        >
          <Gauge
            config={
              normalizedData.casaGauge
            }
            drilldowns={drilldowns}
          />

          <CompositionMosaic
            config={
              normalizedData.depositsComposition
            }
            drilldowns={drilldowns}
            icon={
              Inventory2RoundedIcon
            }
          />
        </Box>
      </DashboardSection>

      <Box
        sx={{
          display: "grid",
          gridTemplateColumns: {
            xs: "1fr",
            lg: "1fr 1fr",
          },
          gap: 2.5,
          mb: {
            xs: 3,
            lg: 4.5,
          },
          alignItems: "stretch",
        }}
      >
        <BarPanel
          icon={
            AccountBalanceWalletRoundedIcon
          }
          config={
            normalizedData.demandDeposits
          }
          drilldowns={drilldowns}
        />

        <BarPanel
          icon={
            DescriptionRoundedIcon
          }
          config={
            normalizedData.termDeposits
          }
          drilldowns={drilldowns}
        />
      </Box>

      <DashboardSection title="Loans">
        <Box
          sx={{
            display: "grid",
            gridTemplateColumns: {
              xs: "1fr",
              lg: "1.2fr 1fr",
            },
            gap: 2.5,
            alignItems: "stretch",
          }}
        >
          <CompositionMosaic
            config={
              normalizedData.loansComposition
            }
            drilldowns={drilldowns}
            icon={
              AccountBalanceRoundedIcon
            }
          />

          <BarPanel
            icon={
              EqualizerRoundedIcon
            }
            config={
              normalizedData.loansBreakdown
            }
            drilldowns={drilldowns}
          />
        </Box>
      </DashboardSection>
    </Box>
  );
}