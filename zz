function Card({ children, sx = {}, onClick }) {
  return (
    <Paper
      elevation={0}
      onClick={onClick}
      sx={{
        borderRadius: "18px",
        border: "1px solid #edf0f5",
        background: "#fff",
        boxShadow: "0 5px 22px rgba(35,55,85,.06)",
        overflow: "hidden",
        cursor: onClick ? "pointer" : "default",
        ...sx,
      }}
    >
      {children}
    </Paper>
  );
}

function Title({ children, sub }) {
  return (
    <Box sx={{ mb: 1.5 }}>
      <Typography
        sx={{
          fontWeight: 800,
          fontSize: { xs: 15, md: 17 },
          color: "#202733",
        }}
      >
        {children}
      </Typography>
      {sub && (
        <Typography sx={{ fontSize: 11, color: "#8a929f", mt: 0.3 }}>
          {sub}
        </Typography>
      )}
    </Box>
  );
}

function Stat({ title, value, line1, line2 }) {
  return (
    <Box
      sx={{
        p: { xs: 1.5, md: 2 },
        minHeight: 130,
        borderRight: { md: "1px solid #e7eaf0" },
        borderBottom: { xs: "1px solid #e7eaf0", md: "none" },
      }}
    >
      <Typography sx={{ color: BLUE, fontSize: 13, fontWeight: 600 }}>
        {title}
      </Typography>

      <Typography
        sx={{
          color: "#315A96",
          fontSize: { xs: 27, md: 31 },
          fontWeight: 500,
          mt: 2,
        }}
      >
        {value}
      </Typography>

      <Box
        sx={{
          mt: 1.3,
          pt: 1,
          background: "#f6f7f9",
          px: 1,
          pb: 1,
        }}
      >
        <Typography sx={{ fontSize: 12, color: "#536070" }}>
          {line1}
        </Typography>
        <Typography sx={{ fontSize: 12, color: PINK }}>
          {line2}
        </Typography>
      </Box>
    </Box>
  );
}


