function MetricCard({ title, value, subtitle, trend, icon }) {
  return (
    <Card
      sx={{
        height: "100%",
        borderRadius: 4,
        border: "1px solid #eeeaf7",
        boxShadow: "0 5px 20px rgba(80,65,130,.07)",
      }}
    >
      <CardContent sx={{ p: 2.2 }}>
        <Box display="flex" justifyContent="space-between">
          <Typography
            sx={{ color: "#68627a", fontSize: 14, fontWeight: 600 }}
          >
            {title}
          </Typography>

          <Box
            sx={{
              width: 38,
              height: 38,
              borderRadius: "50%",
              background: "#f2effb",
              display: "grid",
              placeItems: "center",
              color: purple,
              fontSize: 18,
            }}
          >
            {icon}
          </Box>
        </Box>

        <Typography
          sx={{
            fontSize: 29,
            fontWeight: 700,
            color: "#303044",
            mt: 1,
          }}
        >
          {value}
        </Typography>

        <Typography sx={{ fontSize: 12, color: "#9691a4" }}>
          {subtitle}
        </Typography>

        <Chip
          size="small"
          label={`↑ ${trend}% vs previous year`}
          sx={{
            mt: 1.4,
            fontSize: 11,
            height: 24,
            background: "#e9f7ec",
            color: "#4f9560",
            fontWeight: 600,
          }}
        />
      </CardContent>
    </Card>
  );
}

function ChartCard({ title, subtitle, children, sx = {} }) {
  return (
    <Card
      sx={{
        borderRadius: 4,
        border: "1px solid #eeeaf7",
        boxShadow: "0 5px 20px rgba(80,65,130,.07)",
        height: "100%",
        ...sx,
      }}
    >
      <CardContent sx={{ p: 2.2 }}>
        <Typography
          sx={{
            fontWeight: 700,
            fontSize: 16,
            color: "#37334b",
          }}
        >
          {title}
        </Typography>

        {subtitle && (
          <Typography
            sx={{
              fontSize: 12,
              color: "#9691a4",
              mt: 0.3,
              mb: 1,
            }}
          >
            {subtitle}
          </Typography>
        )}

        {children}
      </CardContent>
    </Card>
  );
}

