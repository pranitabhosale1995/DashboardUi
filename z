function ChartCard({ title, children, large = false, onClick }) {
  return (
    <Paper
      onClick={onClick}
      elevation={0}
      sx={{
        p: 2,
        height: large ? 430 : 335,
        borderRadius: 3,
        background: "#fff",
        border: "1px solid #ECE9F4",
        cursor: onClick ? "pointer" : "default",
        transition: ".2s",
        "&:hover": onClick
          ? {
              transform: "translateY(-2px)",
              boxShadow: "0 12px 30px rgba(70,55,120,.10)"
            }
          : {}
      }}
    >
      <Typography fontWeight={750} fontSize={14}>
        {title}
      </Typography>

      <Typography fontSize={11} color={MUTED} sx={{ mt: .3 }}>
        {onClick ? "Click chart to view details" : " "}
      </Typography>

      <Box sx={{ height: large ? 370 : 275, mt: 1 }}>
        {children}
      </Box>
    </Paper>
  );
}

