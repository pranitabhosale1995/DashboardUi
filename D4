/* ---------------------------------------------------------------------- */
/*  Theme-derived color helpers                                            */
/*  A restrained, finance-appropriate categorical palette: primary /       */
/*  secondary / info / success tones only, at their darker and mid         */
/*  weights. Error / warning are reserved for the CASA gauge's status      */
/*  bands, not category coloring, so they keep their "alert" meaning.      */
/* ---------------------------------------------------------------------- */

function categoricalPalette(theme) {
  const p = theme.palette;
  return [
    p.primary.dark,
    p.info.dark,
    p.secondary.dark,
    p.success.dark,
    p.primary.main,
    p.info.main,
    p.secondary.main,
    p.success.main,
    p.primary.light,
    p.info.light,
  ].filter(Boolean);
}

/** Deterministically maps a category name to a theme color, so "Term
 * Deposit" always renders the same color in the tiles, the bars, and the
 * line chart — without needing a lookup table to maintain. */
function colorForLabel(name, theme) {
  const palette = categoricalPalette(theme);
  let hash = 0;
  for (let i = 0; i < name.length; i += 1) {
    hash = (hash * 31 + name.charCodeAt(i)) >>> 0;
  }
  return palette[hash % palette.length];
}

/* ---------------------------------------------------------------------- */
/*  Shared style helpers                                                   */
/* ---------------------------------------------------------------------- */

const textPrimarySx = { color: "text.primary" };
const textSecondarySx = { color: "text.secondary" };
const RADIUS = { lg: "20px", md: "16px", sm: "12px" };
const CHART_VIEW_OPTIONS_FULL = ["Tiles", "Bar", "Line"];
const CHART_VIEW_OPTIONS_SIMPLE = ["Bar", "Line"];

/* ---------------------------------------------------------------------- */
/*  Glass primitives                                                       */
/*  Cards are noticeably more opaque than a typical glass effect so text   */
/*  and chart data stay crisp against whatever sits behind the page.       */
/* ---------------------------------------------------------------------- */

function GlassPanel({ children, sx, ...props }) {
  const theme = useTheme();

  return (
    <Paper
      elevation={0}
      sx={{
        p: 2.5,
        borderRadius: RADIUS.lg,
        height: "100%",
        background: `linear-gradient(160deg, ${glass.panel(0.6)} 0%, ${glass.panel(0.38)} 100%)`,
        backdropFilter: "blur(24px) saturate(160%)",
        WebkitBackdropFilter: "blur(24px) saturate(160%)",
        border: `1px solid ${glass.border}`,
        boxShadow: theme.shadows[6],
        transition: "box-shadow 0.25s ease, transform 0.25s ease",
        ...sx,
      }}
      {...props}
    >
      {children}
    </Paper>
  );
}

function PanelHeader({ icon: Icon, title, action, iconColor }) {
  const theme = useTheme();
  const color = iconColor || theme.palette.primary.main;

  return (
    <Stack
      direction="row"
      alignItems="center"
      justifyContent="space-between"
      flexWrap="wrap"
      rowGap={1}
      sx={{ mb: 2 }}
    >
      <Stack direction="row" alignItems="center" spacing={1.25}>
        {Icon && (
          <Box
            sx={{
              width: 36,
              height: 36,
              borderRadius: RADIUS.sm,
              display: "flex",
              alignItems: "center",
              justifyContent: "center",
              bgcolor: alpha(color, 0.14),
              color,
              flexShrink: 0,
            }}
          >
            <Icon sx={{ fontSize: 19 }} />
          </Box>
        )}
        <Typography sx={{ ...textPrimarySx, fontWeight: 700, fontSize: 15, letterSpacing: 0.1 }}>
          {title}
        </Typography>
      </Stack>
      {action}
    </Stack>
  );
}

function MiniSelect({ options, value, onChange }) {
  const theme = useTheme();

  return (
    <Select
      size="small"
      value={value}
      onChange={(e) => onChange(e.target.value)}
      sx={{
        ...textPrimarySx,
        fontSize: 12.5,
        fontWeight: 600,
        borderRadius: RADIUS.sm,
        background: glass.panel(0.5),
        backdropFilter: "blur(12px) saturate(160%)",
        "& .MuiOutlinedInput-notchedOutline": { border: `1px solid ${glass.border}` },
        "& .MuiSelect-select": { py: 0.6, pr: 4 },
      }}
    >
      {options.map((opt) => (
        <MenuItem key={opt} value={opt} sx={{ fontSize: 13, fontFamily: theme.typography.fontFamily }}>
          {opt}
        </MenuItem>
      ))}
    </Select>
  );
}

/** A light section header: a slim colored accent, title + caption, and a
 * fading rule trailing to the right. No boxed icon chip — kept quiet on
 * purpose so it doesn't compete with the panels underneath it. */
function SectionHeader({ title, caption }) {
  const theme = useTheme();

  return (
    <Stack direction="row" alignItems="center" spacing={1.25} sx={{ mt: 1.5, pl: 0.25 }}>
      <Box
        sx={{
          width: 4,
          height: 22,
          borderRadius: "999px",
          bgcolor: theme.palette.primary.main,
          flexShrink: 0,
        }}
      />
      <Box sx={{ minWidth: 0 }}>
        <Typography sx={{ ...textPrimarySx, fontSize: { xs: 15, md: 16.5 }, fontWeight: 600, lineHeight: 1.3 }}>
          {title}
        </Typography>
        {caption && (
          <Typography sx={{ ...textSecondarySx, fontSize: 11.5, fontWeight: 500 }}>{caption}</Typography>
        )}
      </Box>
      <Box
        sx={{
          flex: 1,
          height: "1px",
          ml: 1,
          background: `linear-gradient(90deg, ${alpha(theme.palette.text.primary, 0.12)}, transparent)`,
          display: { xs: "none", sm: "block" },
        }}
      />
    </Stack>
  );
}

/* ---------------------------------------------------------------------- */
/*  Legend — a single reusable row of color-dot + label, wraps cleanly.    */
/* ---------------------------------------------------------------------- */

function LegendGrid({ items }) {
  const theme = useTheme();

  return (
    <Box
      sx={{
        mt: 2,
        display: "grid",
        gridTemplateColumns: "repeat(auto-fit, minmax(136px, 1fr))",
        rowGap: 0.85,
        columnGap: 1.5,
      }}
    >
      {items.map((l) => (
        <Stack key={l.name} direction="row" spacing={0.75} alignItems="center">
          <Box
            sx={{
              width: 8,
              height: 8,
              borderRadius: "2px",
              bgcolor: colorForLabel(l.name, theme),
              flexShrink: 0,
            }}
          />
          <Typography sx={{ ...textSecondarySx, fontSize: 11.5, fontWeight: 500 }} noWrap>
            {l.name}
          </Typography>
        </Stack>
      ))}
    </Box>
  );
}

/* ---------------------------------------------------------------------- */
/*  Custom chart tooltip — a small frosted card matching the rest of the   */
/*  UI, in place of Recharts' unstyled default.                            */
/* ---------------------------------------------------------------------- */

function ChartTooltip({ active, payload, label, theme }) {
  if (!active || !payload || !payload.length) return null;
  const value = payload[0].value;
  const color = colorForLabel(label, theme);

  return (
    <Box
      sx={{
        background: glass.panel(0.92),
        backdropFilter: "blur(16px) saturate(160%)",
        border: `1px solid ${glass.border}`,
        borderRadius: RADIUS.sm,
        px: 1.5,
        py: 1,
        boxShadow: theme.shadows[8],
      }}
    >
      <Typography sx={{ fontSize: 11.5, fontWeight: 600, color: "text.secondary" }}>{label}</Typography>
      <Typography sx={{ fontSize: 14, fontWeight: 800, color }}>
        ₹ {value < 1 ? value.toFixed(4) : value} T
      </Typography>
    </Box>
  );
}

/* ---------------------------------------------------------------------- */
/*  CategoryChart — a single {name, value}[] dataset rendered as either a  */
/*  bar chart or a line chart, sharing the same axes/grid/tooltip styling. */
/*  This is what the "Bar" / "Line" dropdown on every panel switches       */
/*  between. Display only — no click-to-drill-down.                       */
/* ---------------------------------------------------------------------- */

function CategoryChart({ data, type }) {
  const theme = useTheme();
  const gridStrokeColor = alpha(theme.palette.text.primary, 0.08);
  const longLabels = data.length > 5;
  const margin = { top: 28, right: 16, left: -4, bottom: longLabels ? 70 : 6 };

  const xAxis = (
    <XAxis
      dataKey="name"
      tick={{ fontSize: longLabels ? 9.5 : 10.5, fill: theme.palette.text.secondary }}
      axisLine={{ stroke: gridStrokeColor }}
      tickLine={false}
      interval={0}
      angle={longLabels ? -35 : 0}
      textAnchor={longLabels ? "end" : "middle"}
      height={longLabels ? 70 : 30}
    />
  );
  const yAxis = (
    <YAxis
      tick={{ fontSize: 11, fill: theme.palette.text.secondary }}
      axisLine={false}
      tickLine={false}
      width={32}
    />
  );

  if (type === "line") {
    return (
      <ResponsiveContainer>
        <LineChart data={data} margin={margin}>
          <CartesianGrid vertical={false} stroke={gridStrokeColor} strokeDasharray="3 5" />
          {xAxis}
          {yAxis}
          <Tooltip
            cursor={{ stroke: alpha(theme.palette.text.primary, 0.18) }}
            content={(props) => <ChartTooltip {...props} theme={theme} />}
          />
          <Line
            type="monotone"
            dataKey="value"
            stroke={theme.palette.primary.main}
            strokeWidth={2.5}
            dot={(dotProps) => {
              const { cx, cy, payload, index } = dotProps;
              return (
                <circle
                  key={`dot-${index}`}
                  cx={cx}
                  cy={cy}
                  r={4.5}
                  fill={colorForLabel(payload.name, theme)}
                  stroke={theme.palette.background.paper}
                  strokeWidth={1.5}
                />
              );
            }}
            activeDot={{ r: 6.5 }}
          />
        </LineChart>
      </ResponsiveContainer>
    );
  }

  return (
    <ResponsiveContainer>
      <BarChart data={data} margin={margin} barCategoryGap="32%">
        <CartesianGrid vertical={false} stroke={gridStrokeColor} strokeDasharray="3 5" />
        {xAxis}
        {yAxis}
        <Tooltip
          cursor={{ fill: alpha(theme.palette.text.primary, 0.05) }}
          content={(props) => <ChartTooltip {...props} theme={theme} />}
        />
        <Bar dataKey="value" radius={[7, 7, 0, 0]} maxBarSize={48}>
          {data.map((d) => (
            <Cell key={d.name} fill={colorForLabel(d.name, theme)} />
          ))}
          <LabelList
            dataKey="value"
            position="top"
            formatter={(v) => `₹${v < 1 ? v.toFixed(4) : v}T`}
            style={{ fontSize: 11, fontWeight: 700, fill: theme.palette.text.primary }}
          />
        </Bar>
      </BarChart>
    </ResponsiveContainer>
  );
}

/* ---------------------------------------------------------------------- */
/*  CASA Gauge (semi-donut + needle) built with Recharts Pie               */
/*  Status bands are a fixed red / amber / green — a traffic-light read    */
/*  rather than category colors — and the needle angle is driven directly  */
/*  by config.value, so it always points to exactly where the number says. */
/* ---------------------------------------------------------------------- */

function Gauge({ config }) {
  const theme = useTheme();
  const RADIAN = Math.PI / 180;
  const cx = 150;
  const cy = 150;
  const innerR = 92;

  const statusPalette = [theme.palette.error.main, theme.palette.warning.main, theme.palette.success.main];
  const segmentColor = (i) => statusPalette[i % statusPalette.length];

  const clampedValue = Math.min(Math.max(config.value, 0), 100);
  const needleAngle = 180 - (clampedValue / 100) * 180; // 0..180 -> deg, driven by the actual value

  return (
    <GlassPanel sx={{ p: 3 }}>
      <PanelHeader icon={PieChartRoundedIcon} title={config.title} />
      <Typography sx={{ ...textSecondarySx, fontSize: 12.5, mt: -1.5, mb: 1.5 }}>
        {config.subtitle}
      </Typography>

      <Box sx={{ position: "relative", width: "100%", height: 232, mb: 1 }}>
        <ResponsiveContainer>
          <PieChart>
            <Pie
              data={config.segments}
              dataKey="value"
              nameKey="name"
              cx="50%"
              cy="85%"
              startAngle={180}
              endAngle={0}
              innerRadius={92}
              outerRadius={130}
              paddingAngle={3}
              cornerRadius={4}
              stroke="none"
              isAnimationActive={false}
            >
              {config.segments.map((s, i) => (
                <Cell key={s.name} fill={segmentColor(i)} />
              ))}
            </Pie>
          </PieChart>
        </ResponsiveContainer>

        {/* needle + center readout, overlaid absolutely */}
        <Box sx={{ position: "absolute", inset: 0, pointerEvents: "none" }}>
          <svg viewBox="0 0 300 300" width="100%" height="100%">
            <circle cx={cx} cy={cy * 0.85 + 0} r="6" fill={theme.palette.text.primary} />
            <line
              x1={cx}
              y1={cy * 0.85}
              x2={cx + (innerR - 6) * Math.cos(needleAngle * RADIAN)}
              y2={cy * 0.85 - (innerR - 6) * Math.sin(needleAngle * RADIAN)}
              stroke={theme.palette.text.primary}
              strokeWidth="3.5"
              strokeLinecap="round"
            />
          </svg>
        </Box>

        <Box sx={{ position: "absolute", left: 0, right: 0, bottom: 6, textAlign: "center" }}>
          <Typography sx={{ ...textPrimarySx, fontSize: 30, fontWeight: 700, lineHeight: 1.1 }}>
            {config.value.toFixed(1)}%
          </Typography>
          <Typography sx={{ ...textSecondarySx, fontSize: 12.5, fontWeight: 500 }}>
            {config.centerLabel}
          </Typography>
        </Box>
      </Box>

      <Stack direction="row" spacing={2.5} justifyContent="center" flexWrap="wrap" sx={{ mt: 1.5 }}>
        {config.segments.map((s, i) => (
          <Stack key={s.name} direction="row" spacing={0.75} alignItems="center">
            <Box sx={{ width: 8, height: 8, borderRadius: "50%", bgcolor: segmentColor(i) }} />
            <Typography sx={{ ...textSecondarySx, fontSize: 11.5, fontWeight: 500 }}>{s.name}</Typography>
          </Stack>
        ))}
      </Stack>
    </GlassPanel>
  );
}

/* ---------------------------------------------------------------------- */
/*  Composition mosaic (used for both Deposits and Loans)                  */
/*  Default view is the tile mosaic — two tall tiles, a stacked pair       */
/*  beside them, and an even row of the remaining categories underneath —  */
/*  each tile filled with a solid, theme-derived color. The dropdown lets  */
/*  the same data be viewed as a Bar or Line chart instead. Display only — */
/*  nothing is clickable, there is no drill-down.                         */
/* ---------------------------------------------------------------------- */

function CompositionMosaic({ config, icon = Inventory2RoundedIcon }) {
  const theme = useTheme();
  const hasFilter = Array.isArray(config.filterOptions) && config.filterOptions.length > 0;
  const [filter, setFilter] = useState(config.activeFilter || (hasFilter ? config.filterOptions[0] : undefined));
  const [view, setView] = useState("Tiles");
  const items = config.items;
  const [big1, big2, stackTop, stackBottom, ...rest] = items;
  const longLabels = items.length > 5;

  const Tile = ({ item, sx, dense }) => {
    const color = colorForLabel(item.name, theme);
    const fg = theme.palette.getContrastText(color);
    return (
      <Box
        sx={{
          borderRadius: RADIUS.sm,
          p: dense ? 1.1 : 1.5,
          display: "flex",
          flexDirection: "column",
          justifyContent: "space-between",
          bgcolor: color,
          color: fg,
          minHeight: 68,
          transition: "transform 0.18s ease, box-shadow 0.18s ease",
          "&:hover": { transform: "translateY(-2px)", boxShadow: theme.shadows[6] },
          ...sx,
        }}
      >
        <Typography
          sx={{
            fontFamily: theme.typography.fontFamily,
            fontSize: dense ? 10.5 : 12,
            fontWeight: 600,
            opacity: 0.92,
            lineHeight: 1.25,
          }}
          noWrap
        >
          {item.name}
        </Typography>
        <Box>
          <Stack direction="row" alignItems="baseline" justifyContent="space-between" spacing={1}>
            <Typography
              sx={{
                fontFamily: theme.typography.fontFamily,
                fontSize: dense ? 14 : 17,
                fontWeight: 700,
                lineHeight: 1.2,
              }}
            >
              ₹ {item.value.toFixed(2)} T
            </Typography>
            <Box
              component="span"
              sx={{
                flexShrink: 0,
                px: 0.7,
                py: 0.1,
                borderRadius: "6px",
                fontSize: dense ? 9.5 : 10.5,
                fontWeight: 700,
                bgcolor: alpha(fg, 0.22),
              }}
            >
              {item.share}%
            </Box>
          </Stack>
          <Box
            sx={{
              mt: 0.6,
              height: 4,
              borderRadius: "999px",
              bgcolor: alpha(fg, 0.25),
              overflow: "hidden",
            }}
          >
            <Box
              sx={{
                height: "100%",
                width: `${Math.min(item.share, 100)}%`,
                bgcolor: fg,
                opacity: 0.9,
                borderRadius: "999px",
              }}
            />
          </Box>
        </Box>
      </Box>
    );
  };

  const controls = (
    <Stack direction="row" spacing={1} flexWrap="wrap" rowGap={1}>
      {hasFilter && <MiniSelect options={config.filterOptions} value={filter} onChange={setFilter} />}
      <MiniSelect options={CHART_VIEW_OPTIONS_FULL} value={view} onChange={setView} />
    </Stack>
  );

  return (
    <GlassPanel>
      <PanelHeader icon={icon} title={config.title} action={controls} />
      <Typography sx={{ ...textSecondarySx, fontSize: 12.5, mt: -1.5, mb: 1.5 }}>{config.subtitle}</Typography>

      {view === "Tiles" ? (
        <>
          <Box sx={{ display: "flex", flexDirection: "column", gap: 1 }}>
            <Box sx={{ display: "flex", gap: 1, height: 190 }}>
              {big1 && <Tile item={big1} sx={{ flex: 1.3 }} />}
              {big2 && <Tile item={big2} sx={{ flex: 1.1 }} />}
              {(stackTop || stackBottom) && (
                <Box sx={{ flex: 1, display: "flex", flexDirection: "column", gap: 1 }}>
                  {stackTop && <Tile item={stackTop} dense sx={{ flex: 1 }} />}
                  {stackBottom && <Tile item={stackBottom} dense sx={{ flex: 1 }} />}
                </Box>
              )}
            </Box>
            {rest.length > 0 && (
              <Box sx={{ display: "flex", gap: 1, height: 84 }}>
                {rest.map((r) => (
                  <Tile key={r.name} item={r} dense sx={{ flex: 1 }} />
                ))}
              </Box>
            )}
          </Box>
          <LegendGrid items={config.legend} />
        </>
      ) : (
        <Box sx={{ width: "100%", height: longLabels ? 320 : 280 }}>
          <CategoryChart data={items} type={view.toLowerCase()} />
        </Box>
      )}
    </GlassPanel>
  );
}

/* ---------------------------------------------------------------------- */
/*  Bar / Line panel (Demand / Term deposits, Loan Distribution)           */
/*  Display only — the dropdown swaps between a bar and a line rendering   */
/*  of the same dataset; nothing is clickable.                            */
/* ---------------------------------------------------------------------- */

function BarPanel({ icon, config, titleOverride }) {
  const [view, setView] = useState("Bar");
  const longLabels = config.data.length > 5;

  return (
    <GlassPanel sx={{ p: 3 }}>
      <PanelHeader
        icon={icon}
        title={titleOverride || config.title}
        action={<MiniSelect options={CHART_VIEW_OPTIONS_SIMPLE} value={view} onChange={setView} />}
      />
      {config.topValue && (
        <Typography sx={{ ...textSecondarySx, fontSize: 12.5, mt: -1.5, mb: 2 }}>
          Largest category: <b>{config.topValue}</b>
        </Typography>
      )}
      <Box sx={{ width: "100%", height: longLabels ? 320 : 270 }}>
        <CategoryChart data={config.data} type={view.toLowerCase()} />
      </Box>
    </GlassPanel>
  );
}

