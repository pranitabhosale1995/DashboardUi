/* ---------------------------------------------------------------------- */
/*  Root Dashboard                                                         */
/*  Layout: header → deposits mosaic + CASA gauge → demand/term bar        */
/*  panels → loans mosaic + loan distribution. Every column collapses to   */
/*  a single stack on small screens, and the root paints its own calm      */
/*  ambient backdrop from theme tokens only.                               */
/* ---------------------------------------------------------------------- */

export default function DepositsLoansDashboard({ data }) {
  const theme = useTheme();
  const dashboardData = data || defaultDashboardData;

  const ambientBackground =
    theme.palette.mode === "dark"
      ? `radial-gradient(1100px 550px at 8% -8%, ${alpha(theme.palette.primary.main, 0.22)}, transparent 60%),` +
        `radial-gradient(900px 500px at 100% 0%, ${alpha(theme.palette.info.main, 0.14)}, transparent 55%),` +
        `${theme.palette.background.default}`
      : `radial-gradient(1100px 550px at 8% -8%, ${alpha(theme.palette.primary.light, 0.16)}, transparent 60%),` +
        `radial-gradient(900px 500px at 100% 0%, ${alpha(theme.palette.info.light, 0.12)}, transparent 55%),` +
        `${theme.palette.background.default}`;

  return (
    <Box
      sx={{
        p: { xs: 1.5, md: 3 },
        display: "flex",
        flexDirection: "column",
        gap: 2.5,
        minHeight: "100vh",
        background: ambientBackground,
      }}
    >
      <DashboardHeader config={dashboardData.header} />

      <SectionHeader title="Deposits" caption="Composition, tenure, and demand vs. term split" />
      <Box
        sx={{
          display: "grid",
          gridTemplateColumns: { xs: "1fr", lg: "2fr 1fr" },
          gap: 2.5,
          alignItems: "stretch",
        }}
      >
        <CompositionMosaic config={dashboardData.depositsComposition} icon={AccountBalanceRoundedIcon} />
        <Gauge config={dashboardData.casaGauge} />
      </Box>

      <Box
        sx={{
          display: "grid",
          gridTemplateColumns: { xs: "1fr", md: "1fr 1fr" },
          gap: 2.5,
        }}
      >
        <BarPanel icon={DescriptionRoundedIcon} config={dashboardData.demandDeposits} />
        <BarPanel icon={DescriptionRoundedIcon} config={dashboardData.termDeposits} />
      </Box>

      <SectionHeader title="Loans" caption="Composition and distribution across loan categories" />
      <Box
        sx={{
          display: "grid",
          gridTemplateColumns: { xs: "1fr", lg: "2fr 1fr" },
          gap: 2.5,
          alignItems: "stretch",
        }}
      >
        <CompositionMosaic config={dashboardData.loansComposition} icon={AccountBalanceWalletRoundedIcon} />
        <BarPanel
          icon={TrendingUpRoundedIcon}
          config={dashboardData.loansBreakdown}
          titleOverride="Loan Distribution"
        />
      </Box>
    </Box>
  );
}
