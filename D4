/* ---------------------------------------------------------------------- */
/*  CASA Gauge (semi-donut + needle) built with Recharts Pie               */
/*  Status bands are a fixed red / amber / green (a traffic-light read),   */
/*  and the needle angle is driven directly by config.value so it always   */
/*  points to exactly where the number says.                               */
/*                                                                          */
/*  FIX: the needle overlay is a plain SVG drawn on top of the Pie using a  */
/*  fixed 300×300 coordinate system. That math only lines up with the Pie  */
/*  underneath it when the container is a SQUARE — if the container is     */
/*  wider than it is tall (which it was, at width:"100%"), the two         */
/*  coordinate systems drift apart and the needle appears to swing off     */
/*  onto the background. Fixing this means giving the gauge a fixed,       */
/*  square, centered box instead of a full-width one.                      */
/* ---------------------------------------------------------------------- */

function Gauge({ config }) {
  const theme = useTheme();
  const RADIAN = Math.PI / 180;
  const cx = 150;
  const cy = 150;
  const innerR = 92;
  const GAUGE_SIZE = 240; // fixed + square, see note above

  // Fixed red / amber / green status bands, not category colors.
  const statusPalette = [theme.palette.error.main, theme.palette.warning.main, theme.palette.success.main];
  const segmentColor = (i) => statusPalette[i % statusPalette.length];

  const clampedValue = Math.min(Math.max(config.value, 0), 100);
  const needleAngle = 180 - (clampedValue / 100) * 180; // 0..180 -> deg, driven by the actual value

  return (
    <GlassPanel sx={{ p: 3 }}>
      <PanelHeader icon={PieChartRoundedIcon} title={config.title} />
      <Typography sx={{ ...textSecondarySx, fontSize: 12.5, mt: -1.5, mb: 1.5 }}>
        {config.subtitle}
      </Typography>

      <Box sx={{ position: "relative", width: GAUGE_SIZE, height: GAUGE_SIZE, mx: "auto", mb: 1 }}>
        <ResponsiveContainer>
          <PieChart>
            <Pie
              data={config.segments}
              dataKey="value"
              nameKey="name"
              cx="50%"
              cy="85%"
              startAngle={180}
              endAngle={0}
              innerRadius={92}
              outerRadius={130}
              paddingAngle={3}
              cornerRadius={4}
              stroke="none"
              isAnimationActive={false}
            >
              {config.segments.map((s, i) => (
                <Cell key={s.name} fill={segmentColor(i)} />
              ))}
            </Pie>
          </PieChart>
        </ResponsiveContainer>

        {/* needle + center readout, overlaid absolutely — now aligned
            correctly because the box above is guaranteed square */}
        <Box sx={{ position: "absolute", inset: 0, pointerEvents: "none" }}>
          <svg viewBox="0 0 300 300" width="100%" height="100%">
            <circle cx={cx} cy={cy * 0.85 + 0} r="6" fill={theme.palette.text.primary} />
            <line
              x1={cx}
              y1={cy * 0.85}
              x2={cx + (innerR - 6) * Math.cos(needleAngle * RADIAN)}
              y2={cy * 0.85 - (innerR - 6) * Math.sin(needleAngle * RADIAN)}
              stroke={theme.palette.text.primary}
              strokeWidth="3.5"
              strokeLinecap="round"
            />
          </svg>
        </Box>

        <Box sx={{ position: "absolute", left: 0, right: 0, bottom: 6, textAlign: "center" }}>
          <Typography sx={{ ...textPrimarySx, fontSize: 30, fontWeight: 700, lineHeight: 1.1 }}>
            {config.value.toFixed(1)}%
          </Typography>
          <Typography sx={{ ...textSecondarySx, fontSize: 12.5, fontWeight: 500 }}>
            {config.centerLabel}
          </Typography>
        </Box>
      </Box>

      <Stack direction="row" spacing={2.5} justifyContent="center" flexWrap="wrap" sx={{ mt: 1.5 }}>
        {config.segments.map((s, i) => (
          <Stack key={s.name} direction="row" spacing={0.75} alignItems="center">
            <Box sx={{ width: 8, height: 8, borderRadius: "50%", bgcolor: segmentColor(i) }} />
            <Typography sx={{ ...textSecondarySx, fontSize: 11.5, fontWeight: 500 }}>{s.name}</Typography>
          </Stack>
        ))}
      </Stack>
    </GlassPanel>
  );
}

/* ---------------------------------------------------------------------- */
/*  Composition mosaic (used for both Deposits and Loans)                  */
/*  Two tall tiles, a stacked pair beside them, and an even row of the     */
/*  remaining categories underneath — each tile filled with a solid,       */
/*  theme-derived color (full box, not just an accent).                    */
/*                                                                          */
/*  DRILL-DOWN DISABLED: tiles are no longer clickable. The click handler  */
/*  and drill-down render branch are commented out, not removed — this is  */
/*  a future requirement, so uncomment `onClick` on the Tile below (and    */
/*  the `if (drilldown)` block) to bring the interaction back.             */
/* ---------------------------------------------------------------------- */

function CompositionMosaic({ config, icon = Inventory2RoundedIcon }) {
  const theme = useTheme();
  const hasFilter = Array.isArray(config.filterOptions) && config.filterOptions.length > 0;
  const [filter, setFilter] = useState(config.activeFilter || (hasFilter ? config.filterOptions[0] : undefined));
  const [drilldown, setDrilldown] = useState(null); // { title, subtitle, data } | null — unused while drill-down is disabled
  const items = config.items;
  const [big1, big2, stackTop, stackBottom, ...rest] = items;

  // Kept for the future drill-down feature — not currently wired to onClick.
  const handleTileClick = (item) => {
    fetchDrilldown(item.name).then((result) => {
      if (result) setDrilldown(result);
    });
  };

  const Tile = ({ item, sx, dense }) => {
    const color = colorForLabel(item.name, theme);
    const fg = theme.palette.getContrastText(color);
    return (
      <Box
        /* DRILL-DOWN DISABLED (future requirement) — uncomment to re-enable:
        onClick={() => handleTileClick(item)}
        role="button"
        tabIndex={0}
        */
        sx={{
          borderRadius: RADIUS.sm,
          p: dense ? 1.1 : 1.5,
          display: "flex",
          flexDirection: "column",
          justifyContent: "space-between",
          bgcolor: color,
          color: fg,
          minHeight: 68,
          transition: "transform 0.18s ease, box-shadow 0.18s ease",
          "&:hover": { transform: "translateY(-2px)", boxShadow: theme.shadows[6] },
          ...sx,
        }}
      >
        <Typography
          sx={{
            fontFamily: theme.typography.fontFamily,
            fontSize: dense ? 10.5 : 12,
            fontWeight: 600,
            opacity: 0.92,
            lineHeight: 1.25,
          }}
          noWrap
        >
          {item.name}
        </Typography>
        <Box>
          <Stack direction="row" alignItems="baseline" justifyContent="space-between" spacing={1}>
            <Typography
              sx={{
                fontFamily: theme.typography.fontFamily,
                fontSize: dense ? 14 : 17,
                fontWeight: 700,
                lineHeight: 1.2,
              }}
            >
              ₹ {item.value.toFixed(2)} T
            </Typography>
            <Box
              component="span"
              sx={{
                flexShrink: 0,
                px: 0.7,
                py: 0.1,
                borderRadius: "6px",
                fontSize: dense ? 9.5 : 10.5,
                fontWeight: 700,
                bgcolor: alpha(fg, 0.22),
              }}
            >
              {item.share}%
            </Box>
          </Stack>
          <Box
            sx={{
              mt: 0.6,
              height: 4,
              borderRadius: "999px",
              bgcolor: alpha(fg, 0.25),
              overflow: "hidden",
            }}
          >
            <Box
              sx={{
                height: "100%",
                width: `${Math.min(item.share, 100)}%`,
                bgcolor: fg,
                opacity: 0.9,
                borderRadius: "999px",
              }}
            />
          </Box>
        </Box>
      </Box>
    );
  };

  /* DRILL-DOWN DISABLED (future requirement) — this branch never runs
     while handleTileClick isn't wired to onClick above, but it's kept
     ready rather than deleted.
  if (drilldown) {
    return (
      <GlassPanel sx={{ p: 3 }}>
        <DrilldownBarChart icon={icon} config={drilldown} onBack={() => setDrilldown(null)} />
      </GlassPanel>
    );
  }
  */

  return (
    <GlassPanel>
      <PanelHeader
        icon={icon}
        title={config.title}
        action={hasFilter ? <MiniSelect options={config.filterOptions} value={filter} onChange={setFilter} /> : undefined}
      />
      <Typography sx={{ ...textSecondarySx, fontSize: 12.5, mt: -1.5, mb: 1.5 }}>{config.subtitle}</Typography>

      <Box sx={{ display: "flex", flexDirection: "column", gap: 1 }}>
        <Box sx={{ display: "flex", gap: 1, height: 190 }}>
          {big1 && <Tile item={big1} sx={{ flex: 1.3 }} />}
          {big2 && <Tile item={big2} sx={{ flex: 1.1 }} />}
          {(stackTop || stackBottom) && (
            <Box sx={{ flex: 1, display: "flex", flexDirection: "column", gap: 1 }}>
              {stackTop && <Tile item={stackTop} dense sx={{ flex: 1 }} />}
              {stackBottom && <Tile item={stackBottom} dense sx={{ flex: 1 }} />}
            </Box>
          )}
        </Box>
        {rest.length > 0 && (
          <Box sx={{ display: "flex", gap: 1, height: 84 }}>
            {rest.map((r) => (
              <Tile key={r.name} item={r} dense sx={{ flex: 1 }} />
            ))}
          </Box>
        )}
      </Box>

      <LegendGrid items={config.legend} />
    </GlassPanel>
  );
}

/* ---------------------------------------------------------------------- */
