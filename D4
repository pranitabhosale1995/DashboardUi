  /* DRILL-DOWN DISABLED (future requirement) — kept ready, not deleted.
  if (drilldown) {
    return (
      <GlassPanel sx={{ p: 3 }}>
        <DrilldownBarChart icon={icon} config={drilldown} onBack={() => setDrilldown(null)} />
